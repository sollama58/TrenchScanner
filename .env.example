# ── Database ─────────────────────────────────────────────────────────────
# Local dev default (matches `service postgresql start` on this machine).
# On Render, this is injected automatically from the trenchscanner-db blueprint service.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trenchscanner"

# ── Auth ─────────────────────────────────────────────────────────────────
# Random 32+ byte secret used to sign session JWTs. Generate with:
#   openssl rand -hex 32
JWT_SECRET="change-me-to-a-random-64-char-hex-string"
# How long a session cookie stays valid.
SESSION_TTL_HOURS="168"

# ── Data sources ─────────────────────────────────────────────────────────
# Helius API key (https://dev.helius.xyz) - used for on-chain truth: mint/freeze
# authority, holder distribution, LP burn checks.
HELIUS_API_KEY=""
# DexScreener has no auth key required (public API), left here for documentation.
DEXSCREENER_BASE_URL="https://api.dexscreener.com"
# Optional: a CoinGecko paid-plan key. Market data falls back to GeckoTerminal whenever DexScreener
# answers lookups blank; with a key that uses CoinGecko's on-chain API on the plan's limit instead
# of the free 30 calls a minute. COINGECKO_REQUESTS_PER_MINUTE is the worker's share.
COINGECKO_API_KEY=""
COINGECKO_REQUESTS_PER_MINUTE=200
# Optional: a Jupiter API key (portal.jup.ag; the free plan is enough). The outcome watcher and
# the empty-wallet check then price on Jupiter first and DexScreener only for what it missed.
JUPITER_API_KEY=""
JUPITER_REQUESTS_PER_MINUTE=50
# Pump.fun public frontend API used for discovering new bonding-curve tokens.
# Unofficial/undocumented - may need adjustment if it changes.
PUMPFUN_BASE_URL="https://frontend-api-v3.pump.fun"
# Live Pump.fun launch/graduation stream (PumpPortal). Empty disables it. Needs Node 22+.
PUMPPORTAL_WS_URL="wss://pumpportal.fun/api/data"

# ── Worker ───────────────────────────────────────────────────────────────
# How often the worker looks for new alerts. A full cycle takes ~10s; this is affordable at one
# minute only because RUGCHECK_CACHE_TTL_MINUTES decouples it from RugCheck's request rate.
SCAN_INTERVAL_MINUTES="1"
# How long a RugCheck report is reused before being re-fetched. Short - everything it reports is
# mutable, unlike mint authority or Mayhem Mode, which are cached permanently.
RUGCHECK_CACHE_TTL_MINUTES="5"
# Wall-clock span holderGrowthPct is measured over. Independent of SCAN_INTERVAL_MINUTES on
# purpose: tying it to the scan cadence made the number mean "growth since the last scan", so
# changing the cadence silently changed what every minHolderGrowthPct threshold was asking for.
HOLDER_GROWTH_WINDOW_MINUTES="30"
MCAP_FILTER_MIN="10000"
MCAP_FILTER_MAX="1000000"
# How long a discovered mint stays on the active watchlist before it's dropped as stale.
WATCHLIST_TTL_HOURS="24"
# Safety cap on how many watchlisted mints get refreshed via DexScreener per scan cycle.
WATCHLIST_MAX_TRACKED="900"
# How long a mint DexScreener has never returned market data for stays in the refresh rotation.
# Mints that have shown life keep the full WATCHLIST_TTL_HOURS; the dead-on-arrival majority
# stops costing refresh capacity after this - see Token.lastLiveAt.
WATCHLIST_PROBATION_MINUTES="120"
# Share of WATCHLIST_MAX_TRACKED reserved for never-live mints. Without a reserve the alive set
# fills the cap, new mints get no refresh slots, and since a mint can't become "alive" until it
# has been refreshed once, the watchlist stops catching new launches entirely.
WATCHLIST_PROBATION_RESERVE_PCT="35"
# Mints last seen between this market cap and the band ceiling keep their watchlist slot
# whatever their age; launch-level mints compete newest-first for the rest.
WATCHLIST_NEAR_BAND_MIN_MCAP_USD="7000"
# Cap on UNCACHED Helius wallet-history lookups per scan cycle - the budget guard for the
# always-on fresh-wallet (sniper) pass. Resolved wallets cache forever, so this only bounds the
# worst case.
WALLET_FRESHNESS_MAX_LOOKUPS_PER_CYCLE="50"
# How long "mint/freeze authority still active" is trusted before re-checking. Revocation is
# permanent and cached forever; this covers only the reversible direction, which used to be
# re-queried every single scan cycle for as long as the mint stayed on the watchlist.
MINT_AUTHORITY_ACTIVE_TTL_MINUTES="20"
# Daily cleanup job - prunes old TokenSnapshot/Token rows that would otherwise grow unbounded.
CLEANUP_HOUR_UTC="4"
SNAPSHOT_RETENTION_DAYS="30"
STALE_TOKEN_RETENTION_DAYS="90"
# Daily outcome-tracking job - records the highest mcap seen since each match, for backtesting.
OUTCOME_TRACKING_HOUR_UTC="5"
# Curated-alerts training data: every rug-screen-passing candidate is sampled (at most once per
# spacing window per token) and its price watched for an hour, labeling "did it 2x cleanly" -
# see packages/core/src/curation/ and apps/worker/src/jobs/candidateOutcomeJob.ts.
CANDIDATE_SAMPLE_SPACING_MINUTES="60"
# "Looks ready" event samples: the curators decide only at the first such moment per token per
# window, and the trainer grades and calibrates on exactly those rows.
CANDIDATE_EVENT_SPACING_MINUTES="60"
CANDIDATE_WATCH_INTERVAL_MINUTES="1"
CANDIDATE_WATCH_MAX_BATCH="2000"
CANDIDATE_OUTCOME_RETENTION_DAYS="180"
MATCH_OUTCOME_RETENTION_DAYS="7"
# Curated Alerts feed: the heuristic curator's composite-score floor (tune emission volume here
# without a deploy) and the per-token re-alert cooldown.
CURATED_MIN_SCORE="45"
CURATED_ALERT_COOLDOWN_HOURS="24"
# Which jobs this worker process runs: "all" (one process, the default), "scanner" (the alert
# path and label grading) or "trainer" (model training, the AI judge loop, nightly sweeps).
# Production runs one of each - see render.yaml and HEARTBEAT_JOB_ROLE in core's heartbeat.ts.
WORKER_ROLE="all"
# Curator training, every CURATOR_TRAINING_INTERVAL_HOURS: walk-forward evaluation vs the
# heuristic; the model only takes over the feed when it wins (and falls back to the heuristic
# when it stops winning). Frequent on purpose while this pipeline is experimental.
CURATOR_TRAINING_INTERVAL_HOURS="2"
CURATOR_TRAINING_WINDOW_DAYS="21"
CURATOR_TRAINING_MAX_ROWS="100000"
# Recency decay half-life for training-sample weights: a sample this many days older than the
# newest counts half as much, so the model tracks the current meta inside the window.
CURATOR_RECENCY_HALF_LIFE_DAYS="14"
CURATED_TARGET_PER_HOUR="6"
CURATOR_MIN_TRAINING_ROWS="1500"
# Model families each training run examines ("logistic", "gbdt"); the one with the better
# out-of-sample hit-rate record ships.
CURATOR_MODEL_FAMILIES="logistic,gbdt"
# A hit-rate cutoff only qualifies when the Wilson lower bound (at this z) of its record meets the
# targets - discounts thin, lucky records. 0 = judge observed rates.
CURATED_CALIBRATION_CONFIDENCE_Z="1"
# A token someone currently has open on a Live Feed page keeps getting rescanned for this long
# after it's last viewed, even if it's dropped out of the MCAP_FILTER_MIN/MAX band - see the
# comment on Token.lastViewedAt in packages/core/prisma/schema.prisma.
ACTIVE_VIEW_WINDOW_MINUTES="10"
# How often the market cap is refreshed for tokens someone currently has open on a Live Feed page
# (market data only - see apps/worker/src/jobs/livePriceJob.ts), and the cap on how many tokens
# one pass will refresh.
# How often the fast match pass runs. This is what actually sets alert latency: it re-prices
# recently-vetted tokens and alerts on user filters with no discovery and no RugCheck/Helius
# work, so it can run in seconds where the full scan cycle is paced by enrichment cost.
FAST_MATCH_INTERVAL_SECONDS="15"
# The floor under every user-filter alert: "flush" (default) holds a match back while the price is
# down 25%+ over 5 minutes; "ready" also needs buyers to hold the last hour's flow and a non-red
# 5 minutes; "off" alerts on any match. A held-back match doesn't start the filter's cooldown.
MATCH_ALERT_GUARD="flush"
LIVE_PRICE_INTERVAL_MINUTES="1"
LIVE_PRICE_MAX_TRACKED="150"

# ── AI reviewer (buy/no-buy second opinion on curated picks) ────────────
# Empty key = reviewer off. AI_REVIEW_MODE: off | shadow (record only) | gate (only send "buy").
ANTHROPIC_API_KEY=""
AI_REVIEW_MODE="shadow"
AI_REVIEW_MODEL="claude-opus-5-5"
AI_REVIEW_EFFORT="medium"
# Gate mode only takes effect once this many "buy" calls are graded and meet the 75%/50% targets.
AI_REVIEW_MIN_GRADED_BUYS="50"
# The reviewer's learning loop: daily playbook evolution, tested by replaying recent alerts through
# the Message Batches API. One round replays AI_REPLAY_MAX_ROWS alerts x 3 playbooks at half price.
AI_PLAYBOOK_EVOLUTION="true"
AI_PLAYBOOK_EVOLUTION_HOURS="24"
AI_PLAYBOOK_MIN_GAIN="3"
AI_PLAYBOOK_MIN_BUYS="10"
AI_REPLAY_HOLDOUT_DAYS="3"
AI_REPLAY_MAX_ROWS="150"
# Learned blend of the reviewer's odds and the model's; replaces the bare no_buy veto in gate mode
# once fitted on this many graded reviews and better than the model alone out of sample.
AI_BLEND_MIN_ROWS="150"
# Claude's read of each in-band mint's name/description, fed to the models as features.
AI_TEXT_FEATURES="true"
AI_TEXT_MODEL="claude-haiku-4-5"
# Ignored by Haiku, which takes no effort setting.
AI_TEXT_EFFORT="low"
AI_TEXT_MAX_PER_HOUR="60"
# TokenSage (the user's narrative API): what each scanned coin is about, stored in TokenNarrative.
# Off until TOKENSAGE_ENABLED="true" and both the URL and key are set. Nothing waits on it.
# Production: TOKENSAGE_API_URL="https://tokensage-api.onrender.com", key named "trenchscanner".
# To start on quick reads only, set TOKENSAGE_FULL_PER_DAY="0"; raise it once results look right.
TOKENSAGE_ENABLED="false"
TOKENSAGE_API_URL=""
TOKENSAGE_API_KEY=""
# Quick read for every launch at discovery, so it lands before most first decisions (~25 launches/min).
TOKENSAGE_BASIC_AT_DISCOVERY="false"
TOKENSAGE_MAX_BATCHES_PER_CYCLE="2"
TOKENSAGE_FULL_PER_DAY="6000"
# Young coins (under this many minutes) with an X link get the deep read at once; 0 = off.
TOKENSAGE_EARLY_FULL_MAX_AGE_MINUTES="10"
# Of TOKENSAGE_FULL_PER_DAY, at most this many go to those early deep reads.
TOKENSAGE_EARLY_FULL_PER_DAY="4500"
# Re-send queued TokenSage requests between scans every this many seconds; 0 = scan only.
TOKENSAGE_POLL_SECONDS="8"
# Hard daily cap (USD, per UTC day) across the reviewer, the text reads and playbook evolution.
# Once reached the AI stops until midnight UTC. The last AI_BUDGET_REVIEW_RESERVE_PCT of it is kept
# for reviews of high-conviction picks. 0 stops every AI call.
AI_DAILY_BUDGET_USD="10"
AI_BUDGET_REVIEW_RESERVE_PCT="40"
# Standard (not high-conviction) picks: "spare" reviews them from budget left above the reserve,
# "never" skips them.
AI_REVIEW_STANDARD_PICKS="spare"

# ── Curated feed quality ─────────────────────────────────────────────────
# Hold the hand-tuned curator to the hit-rate targets (rank-score cutoff from its own record).
CURATED_HEURISTIC_PRECISION_GATE="true"
CURATOR_RULES_FROM_BEST="true"
# Curated calls wait until both top-10 wallet checks (fresh / empty wallets) are measured.
CURATED_REQUIRE_WALLET_CHECKS="true"
# Minutes a curated pick that lost its slot to the pace cap keeps re-contending (0 = never).
CURATED_CONTENDER_RETRY_MINUTES="15"

# ── API / Web ────────────────────────────────────────────────────────────
API_PORT="4000"
# Comma-separated list of origins allowed to call the API (the deployed dashboard + local dev).
# In production: https://trenchscanner.app,https://www.trenchscanner.app,https://holdex.live,
# https://www.holdex.live,https://trenchscanner-web.onrender.com
CORS_ORIGINS="http://localhost:5173"
# Each dashboard's real host[:port], no protocol, comma-separated. Anti-phishing anchor for Sign-In
# With Solana - see the comment on this var in packages/core/src/config/env.ts. In production:
# "trenchscanner.app,www.trenchscanner.app,holdex.live,trenchscanner-web.onrender.com"; locally, the Vite dev server (5173 by default).
PUBLIC_APP_DOMAIN="localhost:5173"
# Comma-separated base58 wallet addresses allowed into the Admin Panel (GET/POST /admin/*).
# Empty by default - the Admin Panel is unreachable (every request 403s) until you set this to
# your own wallet's address.
ADMIN_WALLET_ADDRESSES=""

# ── Telegram alerts ─────────────────────────────────────────────────────
# A bot token from @BotFather turns on Telegram alerts (Filters tab -> Telegram alerts). Needed by
# the api (webhook, link codes) and the worker (sending). Empty = the feature is off.
TELEGRAM_BOT_TOKEN=""
# The api's public webhook URL, registered with Telegram at startup; empty leaves the bot's
# webhook as it is (local dev: use an https tunnel, or leave empty and test the routes directly).
TELEGRAM_WEBHOOK_URL=""
# The dashboard alert messages link back to; empty derives it from PUBLIC_APP_DOMAIN.
TELEGRAM_DASHBOARD_URL=""
TELEGRAM_DISPATCH_INTERVAL_SECONDS=10

# Subscription / burn gate
SOLANA_RPC_URL=
BURN_SCAN_INTERVAL_MINUTES=3
BURN_SCAN_COLD_START_DAYS=400
