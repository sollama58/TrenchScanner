{
  "name": "@trenchscanner/extension",
  "version": "0.8.2",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "Trench Overlay: a side panel of TrenchScanner alerts beside Axiom, Terminal and GMGN",
