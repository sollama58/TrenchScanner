{
  "manifest_version": 3,
  "name": "Trench Overlay",
  "short_name": "Trench Overlay",
  "version": "0.2.2",
  "description": "Your TrenchScanner alerts, with their flags, in a panel beside Axiom, Terminal and GMGN.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://api.trenchscanner.app/*"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "externally_connectable": {
    "matches": ["https://trenchscanner.app/*", "https://www.trenchscanner.app/*"]
  },
  "action": {
    "default_title": "Open Trench Overlay",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Open the panel"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; img-src 'self' https: data:; connect-src https://api.trenchscanner.app"
  }
}
