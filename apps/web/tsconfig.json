{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    // Resolves @trenchscanner/core/chartMarks to its source. Render's web build does not compile
    // packages/core, and the Node conditions of that export stay on dist for the api and worker.
    "customConditions": ["trenchscanner-web"]
  },
  "include": ["src", "vite.config.ts"]
}
