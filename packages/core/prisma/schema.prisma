// TrenchScanner data model
// See PLANNING.md section 4 for the design rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per background job (scan, cleanup, ...), updated on every run whether it
/// succeeds or fails. This is what lets the API/dashboard answer "is the worker actually alive"
/// without needing a separate monitoring service - see packages/core/src/heartbeat.ts.
model SystemHeartbeat {
  job           String    @id
  lastRunAt     DateTime
  lastSuccessAt DateTime?
  lastError     String?
  meta          Json?
  updatedAt     DateTime  @updatedAt
}

/// One run of the composite score's weight fit (packages/core/src/scoring/scoreWeights.ts). The
/// newest adopted row is the set every process scores with; rows that weren't adopted stay as
/// the record of what the data said.
model ScoreWeightRun {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  momentum      Float
  freshness     Float
  holderQuality Float
  narrative     Float
  adopted       Boolean
  reason        String
  metrics       Json

  @@index([adopted, createdAt])
}

/// A person, identified by their Solana wallet (Sign-In With Solana).
model User {
  id              String   @id @default(cuid())
  walletAddress   String   @unique
  createdAt       DateTime @default(now())
  /// Stamped into every browser session's JWT and checked on each request. Signing out bumps it,
  /// which revokes every browser session the user holds - a JWT can't be withdrawn on its own.
  /// Paired phones are revoked per device instead (LinkedDevice.revokedAt).
  sessionVersion  Int      @default(0)
  /// The curator contestant whose calls this user's Curated feed shows (curation/contestants.ts);
  /// null = the default (the consensus, or Rules until the consensus can call).
  curatedModel    String?
  /// Every contestant whose calls the dashboard's combined feed shows (checkboxes on Live and the
  /// Models tab). Empty = follow the default. curatedModel is kept equal to the first entry so the
  /// single-ledger /curated feed (other clients) shows one of the same models.
  feedModels      String[] @default([])
  /// Whether model calls are mixed into the combined feed at all; off = only this user's filter matches.
  showModelAlerts Boolean  @default(true)
  /// Follow the best performer (CuratorChampion): the feed shows whichever model holds the default
  /// and switches when a new one is chosen. Picking models by hand turns it off; feedModels then
  /// decides. Kept separate from feedModels so switching back keeps the user's hand picks.
  followBestModel Boolean  @default(true)
  /// How alerts reach this user in the dashboard (sound, volume, browser notifications) - see
  /// alertPrefs.ts in apps/api for the shape. Null = defaults.
  alertPrefs      Json?
  /// How the Live feed looks for this user (theme, colors, spacing, columns, which card fields
  /// show) - see feedAppearance.ts in apps/api for the shape. Null = the default look.
  feedAppearance  Json?

  filters           UserFilter[]
  matches           Match[]
  subscription      Subscription?
  burns             BurnEvent[]
  linkCodes         MobileLinkCode[]
  devices           LinkedDevice[]
  telegramLinkCodes TelegramLinkCode[]
  telegramChats     TelegramChat[]
}

/// A single-use code, shown as a QR on a signed-in desktop, that mints a session on a phone.
///
/// Only the SHA-256 of the code is stored. The raw value exists in the desktop's response and in
/// the QR pixels and nowhere else, so a dump of this table cannot be replayed into anyone's
/// account - the same discipline AuthNonce follows.
///
/// The window is deliberately tiny. A QR on a screen is visible to whoever is in the room and to
/// anything recording it, so its usefulness has to end almost immediately; single-use is not
/// enough on its own, because an unclaimed code would otherwise stay valid indefinitely.
model MobileLinkCode {
  id       String @id @default(cuid())
  codeHash String @unique
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  expiresAt DateTime
  /// Set the instant it is redeemed. The claim is a conditional update, so two phones racing the
  /// same code cannot both win - see redeemLinkCode.
  claimedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

/// A single-use code that links a Telegram chat to this account, carried in a t.me deep link
/// (t.me/<bot>?start=<code>). The same discipline as MobileLinkCode: only the SHA-256 is stored,
/// the raw value is returned to the signed-in dashboard exactly once, the code expires in minutes
/// and is claimed with a conditional update so two chats racing it cannot both win.
model TelegramLinkCode {
  id       String @id @default(cuid())
  codeHash String @unique
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  expiresAt DateTime
  claimedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

/// A Telegram chat (a private chat with the bot, or a group it was added to) that receives one
/// account's Live Feed alerts: that account's filter matches and the calls of the models in its
/// feed. Linked by redeeming a TelegramLinkCode in the chat (/start <code>); in a group only a
/// group admin may do so. A chat belongs to at most one account at a time (chatId is unique), so
/// re-linking it moves it rather than duplicating it.
model TelegramChat {
  id                 String  @id @default(cuid())
  /// Telegram's chat id: positive for a private chat, negative for groups and supergroups.
  chatId             BigInt  @unique
  /// "private" | "group" | "supergroup" | "channel", as Telegram reports it.
  kind               String
  /// The group's title, or the person's name in a private chat. Untrusted text: rendered, never interpreted.
  title              String?
  userId             String
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The Telegram user who redeemed the code, for the dashboard's "linked by" line.
  linkedByTelegramId BigInt?
  linkedByName       String?

  /// Which alerts this chat gets.
  filterMatches Boolean   @default(true)
  modelCalls    Boolean   @default(true)
  /// Paused by the user from the dashboard; the chat stays linked.
  enabled       Boolean   @default(true)
  /// Alerts raised at or before this were sent (or never due) - the dispatcher's cursor per chat.
  /// Starts at link time, so linking never replays the backlog.
  sentThrough   DateTime  @default(now())
  lastSentAt    DateTime?
  /// What Telegram last answered when a send failed; cleared on the next success.
  lastError     String?
  failures      Int       @default(0)

  createdAt DateTime  @default(now())
  /// Unlinked from the dashboard, or the bot was blocked / removed from the group. Kept for the
  /// record; a fresh /start in the same chat revives the row.
  revokedAt DateTime?

  @@index([userId])
}

/// A phone that has been linked to an account, and the thing that makes those sessions revocable.
///
/// Sessions here are stateless JWTs, so a token cannot be withdrawn once issued - the only lever
/// is to stop honouring it. A device session's JWT carries this row's id, and every request
/// resolves it (see resolveSession); revoking sets revokedAt and the next request from that phone
/// is rejected. That is what lets a linked phone last until it is revoked rather than until an
/// expiry nobody chose.
model LinkedDevice {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  /// Throttled, not written per request - see touchDevice.
  lastSeenAt DateTime  @default(now())
  /// Whatever the phone reported when it redeemed, so the list is recognisable ("iPhone, Safari")
  /// rather than a row of identical cuids. Untrusted client text: rendered, never interpreted.
  userAgent  String?
  revokedAt  DateTime?

  @@index([userId])
}

/// Short-lived nonce a wallet must sign to authenticate. One-time use.
model AuthNonce {
  id            String    @id @default(cuid())
  walletAddress String
  nonce         String    @unique
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?

  @@index([walletAddress])
}

/// A saved filter configuration. A user may have more than one.
model UserFilter {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String @default("Default")
  mcapMin Float  @default(50000)
  mcapMax Float  @default(500000)

  minVolumeMcapRatio         Float? // volume24h / marketCap, momentum signal
  minHolderGrowthPct         Float? // % holder growth over the lookback window
  // These four used to be part of the mandatory automatic rug screen (packages/core/src/scoring/
  // rugScreen.ts) - different users legitimately want different thresholds here, unlike mint/
  // freeze authority or LP lock, so they moved to being opt-in criteria instead. Unset (null/
  // false) means "don't check this," not "reject unless known" - see matchFilters.ts.
  maxTop10HolderPct          Float? // top-10 holder concentration, %
  maxDevWalletPct            Float? // creator's own holding, % (only if they rank in the top 10)
  maxRiskScore               Float? // RugCheck's own composite risk score, 0-100 (higher = riskier)
  excludeCriticalRiskFlags   Boolean  @default(false) // e.g. "Creator history of rugged tokens"
  /// Float, not Int: people filtering the very freshest launches think in seconds, and 0.25 is
  /// how you say fifteen of them without inventing a second unit. See TokenSnapshot.ageMinutes,
  /// which carries matching precision - a fractional bound compared against a whole-minute age
  /// would quietly round away and do nothing.
  minTokenAgeMinutes         Float?
  maxTokenAgeMinutes         Float?
  narrativeKeywords          String[] @default([])
  minScore                   Float? // minimum composite score, 0-100
  maxFreshTop10WalletPct     Float? // % of top-10 holders funded <24h ago (sniper/insider signal)
  /// % of top-10 holders whose non-cash token holdings are worth less than
  /// WALLET_HOLDINGS_MIN_USD - wallets that exist only to hold this launch (see
  /// apps/worker/src/jobs/walletHoldings.ts). The substance counterpart to
  /// maxFreshTop10WalletPct's wallet-age test: a sniper farm can age its wallets, but funding
  /// each one with a real portfolio costs real money.
  maxEmptyTop10WalletPct     Float?
  /// Bounds on how many of the launch's first 25 buyers still hold it (TokenSnapshot.firstBuyersHolding).
  minFirstBuyersHolding      Int?
  maxFirstBuyersHolding      Int?
  /// TokenSage narrative criteria (packages/core/src/scoring/matchFilters.ts): only / never these
  /// category labels, no copycats, no high-severity flags, no unrelated or spoofed X post, trend
  /// match required. All fail closed without a read.
  narrativeCategories        String[] @default([])
  excludeNarrativeCategories String[] @default([])
  excludeCopycats            Boolean  @default(false)
  excludeNarrativeRedFlags   Boolean  @default(false)
  excludeUnrelatedX          Boolean  @default(false)
  requireTrendMatch          Boolean  @default(false)
  excludeLateCopies          Boolean  @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// When this filter last started matching from scratch: created, switched on, or its criteria
  /// changed. For FILTER_ARM_QUIET_MINUTES after this, tokens that already match it are recorded
  /// in FilterBaseline instead of alerted - a new filter alerts on what newly matches from now
  /// on, not on the whole watchlist at once (apps/worker/src/jobs/matchDispatch.ts).
  armedAt   DateTime @default(now())

  /// Opted in to the public filter leaderboard by its owner (off by default). The board shows the
  /// filter's name and settings, never the owner's wallet - see apps/api/src/filterLeaderboard.ts.
  shareOnLeaderboard Boolean   @default(false)
  /// When the matching criteria last changed (a name, active or sharing change doesn't count).
  /// The leaderboard record counts only alerts raised since, so it always belongs to the settings
  /// a copier would get. Filters from before 2026-10-05 start at createdAt.
  criteriaChangedAt  DateTime  @default(now())
  /// The best leaderboard rank it ever held, written as the board is built (null: never ranked).
  bestRank           Int?
  /// Retired: its owner deleted it, but it had ranked in the board's top few, so its alert
  /// history and record are kept. Hidden from the owner, never active, still on the board (see
  /// KEEP_IF_EVER_RANKED_WITHIN in apps/api/src/routes/filters.ts).
  deletedAt          DateTime?

  matches   Match[]
  baselines FilterBaseline[]

  @@index([userId])
}

/// Tokens that already matched a filter when it was armed (see UserFilter.armedAt). Counts as the
/// alert cooldown for that (filter, token) pair, so the backlog never shows up as "just now"
/// alerts. Not a Match: nothing here is shown, graded or notified. tokenId carries no foreign
/// key - rows are swept by age (cleanupJob.ts), and Token deletes stay off this table.
model FilterBaseline {
  filterId  String
  filter    UserFilter @relation(fields: [filterId], references: [id], onDelete: Cascade)
  tokenId   String
  createdAt DateTime   @default(now())

  @@id([filterId, tokenId])
  @@index([createdAt])
}

/// A distinct Solana token being tracked.
model Token {
  id                      String    @id @default(cuid())
  mintAddress             String    @unique
  symbol                  String?
  name                    String?
  pairAddress             String? // primary DexScreener pair used for pricing
  /// The token's logo, as hosted by DexScreener. Read from the pair response the scan already
  /// fetches rather than derived from the mint address: CDN URL shapes are undocumented and
  /// change, and a guessed one 404s silently for every mint that has no artwork - which is a lot
  /// of them. Null means DexScreener has no image, not that we failed to look.
  imageUrl                String?
  firstSeenAt             DateTime  @default(now())
  hasTwitter              Boolean   @default(false)
  hasTelegram             Boolean   @default(false)
  hasWebsite              Boolean   @default(false)
  /// The launcher's X/Twitter and website links as found at discovery (Pump.fun's `twitter` /
  /// `website`, or DexScreener's profile links). Only https URLs are kept; a bare X handle is
  /// stored as its https://x.com/ URL. Null when the source had none. Kept so the AI reviewer,
  /// the cards and TokenSage (see TokenNarrative) can look at what the coin links to.
  twitterUrl              String?
  websiteUrl              String?
  narrativeTags           String[]  @default([])
  /// The launcher-written description from Pump.fun, captured at discovery. Re-scans come from
  /// DexScreener, which has none, so this is the only copy - it feeds narrative tags and the AI
  /// reviewer's brief.
  description             String?
  /// Which discovery source first added the mint: "pumpfun", "pumpfun-active" (the
  /// recently-traded list), "pumpfun-koth" (king of the hill), "pumpportal" (live new-token
  /// stream) or "dexscreener". Null for rows added before this was recorded.
  discoverySource         String?
  /// Whether the mint has ever appeared on DexScreener's paid-boost feed. Sticky (false -> true
  /// only); a model feature, so the learner can say whether a paid boost helps or hurts.
  dexBoosted              Boolean   @default(false)
  /// The first scan that saw the mint inside the curated mcap band. Feeds the
  /// minutesSinceFirstInBand feature: a token that entered the band hours ago and is still
  /// there is a different bet from one arriving now.
  firstInBandAt           DateTime?
  /// The newest top-10 empty-wallet and fresh-wallet shares any scan measured, kept here because
  /// the wallet checks are rationed: a card whose alert snapshot and newest snapshot both lack a
  /// reading still shows the last one known. Written only when it changes. Null = never measured.
  lastEmptyTop10WalletPct Float?
  lastFreshTop10WalletPct Float?
  /// Claude's read of the launcher-written text (name, symbol, description), scored once per mint
  /// by apps/worker/src/ai/textScorer.ts - a TextScores object (curation/textFeatures.ts). These
  /// become model features, so the learners decide how much the read is worth. Null until scored.
  aiTextScores            Json?
  aiTextScoredAt          DateTime?

  // Stamped by GET /matches (see apps/api/src/routes/matches.ts) whenever this token appears on
  // a page someone actually fetched - not per-user, just "is anyone currently looking at this."
  // The scan job (apps/worker/src/jobs/scanJob.ts) keeps re-scanning a token within
  // ACTIVE_VIEW_WINDOW_MINUTES of this timestamp even after it's dropped out of the mcap band,
  // so a genuine breakout winner someone has open doesn't go stale the moment it leaves the
  // MCAP_FILTER_MIN/MAX band - but a token nobody's looking at anymore is left alone once it's
  // out of band, rather than tracking every historical match forever.
  lastViewedAt DateTime?

  // A lightweight, display-only price ping for tokens someone currently has open, refreshed far
  // more often than a full scan cycle (see apps/worker/src/jobs/livePriceJob.ts). Deliberately
  // NOT a TokenSnapshot: a snapshot is a full point-in-time evaluation that feeds scoring,
  // matching and history, and minting one every minute purely to move a number on screen would
  // both bloat that table and attach stale on-chain/score data to fresh market data. These three
  // fields are the opposite - current market data with no claim to anything else. Null until the
  // first refresh; `liveDataAt` is what lets a reader tell whether this or the latest snapshot is
  // actually fresher (see currentMarketCap() in apps/api/src/routes/matches.ts).
  liveMarketCapUsd Float?
  livePriceUsd     Float?
  liveDataAt       DateTime?

  // Last time DexScreener returned any market data for this mint - i.e. it has (or had) a real
  // pair or bonding curve trading somewhere. This is what the scan's watchlist selection
  // prioritizes on: mints that have shown life keep their full WATCHLIST_TTL_HOURS of tracking,
  // while never-live mints only get WATCHLIST_PROBATION_MINUTES before they stop being refreshed.
  // Without this split, eviction was purely newest-first, and at real Pump.fun launch rates the
  // newest WATCHLIST_MAX_TRACKED mints span well under an hour - so a token that took two hours
  // to climb into the band silently fell off the radar. Null = never seen live by DexScreener.
  lastLiveAt  DateTime?
  /// The market cap DexScreener reported the last time this mint was refreshed (stamped with
  /// lastLiveAt). What the watchlist ranks on: a mint near or inside the mcap band keeps its
  /// refresh slot however old it is, while launch-level mints compete newest-first for what's
  /// left - see selectWatchlist.
  lastMcapUsd Float?

  snapshots              TokenSnapshot[]
  matches                Match[]
  candidateOutcomes      CandidateOutcome[]
  curatedAlerts          CuratedAlert[]
  curatedShadowEmissions CuratedShadowEmission[]
  aiReviews              AiReview[]

  // The watchlist selection (selectWatchlist in apps/worker/src/jobs/scanJob.ts) ranges and orders
  // on this every scan cycle. Without it all three of its queries scanned and sorted the whole
  // table - every mint ever discovered - which was 20s of each production cycle on 2026-10-03.
  @@index([firstSeenAt])
  @@index([lastViewedAt])
}

/// A token the curator promoted to the Curated Alerts feed - the public, self-grading output of
/// the self-learning pipeline. One row per emission (at most one per token per cooldown window).
/// The feed's track record IS the product's marketing, so outcome numbers are copied in from the
/// linked CandidateOutcome as its windows close - the copies survive the training set's own
/// retention horizon, and until they land the API reads the live link instead.
model CuratedAlert {
  id      String @id @default(cuid())
  tokenId String
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  /// The training row whose anchor this alert shares. SetNull, not Cascade: pruning the training
  /// set after CANDIDATE_OUTCOME_RETENTION_DAYS must not erase the public track record.
  candidateOutcomeId String?
  candidateOutcome   CandidateOutcome? @relation(fields: [candidateOutcomeId], references: [id], onDelete: SetNull)

  /// The scan snapshot this alert was emitted from - the same "alerted at" row a Match carries,
  /// so a curated alert can render with the full statistics a Live Feed card shows (volume,
  /// age, graduation, holder concentration) instead of just a market cap. SetNull rather than
  /// Cascade, and deliberately NOT protected from the snapshot retention sweep: the feed's own
  /// record has to outlive the 30-day snapshot horizon, and a card older than that degrades to
  /// the anchor figures copied onto this row rather than disappearing.
  snapshotId String?
  snapshot   TokenSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  /// Which decision-maker emitted it - "heuristic-v1", or the CuratorModel id whose weights made
  /// the call - so every call is traceable to the exact model generation.
  source        String
  /// The contestant whose ledger this call is on (curation/contestants.ts): every contestant calls
  /// on its own feed, governed and graded separately - the leaderboard is built from these.
  /// Null only on rows written before the contest existed (the migration backfilled those).
  model         String?
  /// The name the model held when it made this call. Evolving seats change recipe and name
  /// (CuratorLane), so the card keeps showing who actually called it.
  modelName     String?
  /// The curator's conviction at emission, 0-100.
  confidence    Float
  /// "high" when the call cleared the model's high-conviction line (CURATED_HIGH_CONVICTION_RANK),
  /// "standard" otherwise; null on rules calls and rows from before tiers existed.
  tier          String?
  /// The 2x rate of recent out-of-sample calls ranked like this one, in percent, from the model's
  /// calibration table at emission; null when it had none.
  calibratedPct Float?
  /// Why, as short human-readable strings - the top contributing signals at emission time.
  reasons       String[] @default([])

  anchorPriceUsd Float
  anchorMcapUsd  Float

  /// Outcome copies - written by the watcher when the linked row's goal window (and, for
  /// winners, its 24h watch) closes. Null until then; the API prefers the live candidateOutcome
  /// link while it exists.
  peak1hReturnPct    Float?
  maxDrawdown1hPct   Float?
  /// Doubled within the first 15 minutes - the same test as hit2xIn1h since 2026-10-05.
  hit2xIn15m         Boolean?
  /// THE verdict: doubled within the 15-minute win window (without first breaching the stop -
  /// see `disqualified`). The name predates the window; it was one hour until 2026-10-05.
  hit2xIn1h          Boolean?
  /// Cleared the 4x goal inside the 30-minute goal window.
  hit4xIn1h          Boolean?
  /// The third tier: a clean win that reached 10x within an hour of the alert, before the stop.
  /// Written when the hour closes (or at the 30-minute close when that already settles it).
  hit10xIn1h         Boolean?
  disqualified       Boolean?
  /// The run peak: how far the call ultimately went over the 24h watch, on the fill.
  peak24hReturnPct   Float?
  /// Minutes from the alert to the run peak.
  runPeakMinutes     Float?
  outcomeFinalizedAt DateTime?
  /// Copy of CandidateOutcome.simReturnPct: the call's return under the fixed exit plan.
  simReturnPct       Float?

  /// The Narrative seat's view of a coin another seat already called: "agrees" when its deep
  /// read would have called it too, "warns" when it would not. The seat decides when TokenSage's
  /// deep read lands, usually after the call went out, and instead of a second card it leaves
  /// this note on the one already showing (decided 2026-10-07). Null until the deep read decides,
  /// and on the Narrative seat's own calls.
  narrativeVerdict String?
  narrativeNotedAt DateTime?

  aiReviews AiReview[]

  @@index([createdAt])
  @@index([tokenId, createdAt])
  // Foreign keys with ON DELETE SET NULL: without these, every TokenSnapshot / CandidateOutcome
  // the nightly cleanup deletes scans this table to null its references.
  @@index([snapshotId])
  @@index([candidateOutcomeId])
  @@index([model, createdAt])
}

/// What the BENCH curator would have emitted - the newest candidate model while the heuristic
/// holds the job, or the heuristic while a model does. Recorded from the same scan moments and
/// graded by the same CandidateOutcome labels as real alerts, so the two curators build a live,
/// production track record side by side instead of only meeting in walk-forward backtests.
/// Invisible to subscribers; the learning panel reads it in aggregate. One row per would-be
/// emission, under the same per-token cooldown as the real feed so the rates stay comparable.
model CuratedShadowEmission {
  id      String @id @default(cuid())
  tokenId String
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  /// The training row whose anchor this shadow pick shares - grading joins through it (no
  /// outcome copies here: shadow rows are evaluation data, pruned on the same horizon as the
  /// training set itself, so the link never outlives what it points at by design).
  candidateOutcomeId String?
  candidateOutcome   CandidateOutcome? @relation(fields: [candidateOutcomeId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())
  /// Which bench curator made the call - "heuristic-v1" or a CuratorModel id.
  source     String
  confidence Float

  anchorPriceUsd Float
  anchorMcapUsd  Float

  @@index([createdAt])
  @@index([tokenId, createdAt])
  @@index([source, createdAt])
  @@index([candidateOutcomeId])
}

/// One trained curator - the output of a training run (apps/worker/src/jobs/
/// curatorTrainingJob.ts) over the CandidateOutcome training set. Kept as data, not code: the
/// weights, the feature scaling, the emission threshold, and the walk-forward evidence all live
/// in this row, so promotion is auditable and rollback is "flip status back". At most one row is
/// ACTIVE at a time; while none is, the hand-tuned heuristic curates (curation/curator.ts).
/// One AI reviewer call on a curated pick (apps/worker/src/ai/reviewer.ts): Claude's buy/no-buy
/// verdict, graded by the same CandidateOutcome labels as the alerts, so its record can be
/// checked before it is trusted to gate the feed (AI_REVIEW_MODE). In gate mode a "no_buy" pick
/// is never sent, but its review row still anchors an outcome - that is what shows whether the
/// vetoes were right.
model AiReview {
  id      String @id @default(cuid())
  tokenId String
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  candidateOutcomeId String?
  candidateOutcome   CandidateOutcome? @relation(fields: [candidateOutcomeId], references: [id], onDelete: SetNull)
  /// The alert that was sent for this pick, if one was (null for a gate-mode veto).
  curatedAlertId     String?
  curatedAlert       CuratedAlert?     @relation(fields: [curatedAlertId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  /// "shadow" or "gate" - which mode the reviewer ran in for this call.
  mode          String
  model         String
  /// "buy" or "no_buy"; null when the call failed (see error).
  decision      String?
  probability2x Float?
  probability4x Float?
  reasoning     String?
  risks         String[] @default([])
  error         String?
  latencyMs     Int
  inputTokens   Int?
  outputTokens  Int?

  anchorPriceUsd Float
  anchorMcapUsd  Float

  /// The playbook (AiPlaybook) the reviewer ran with - so every verdict is traceable to the exact
  /// instructions that produced it. Null on rows from before playbooks existed.
  playbookId         String?
  /// The exact per-token brief the reviewer was shown, so a call can be audited and replayed.
  brief              String?
  /// The default model's own calibrated 2x probability for this pick (0-1), when it is a trained
  /// model - the other input of the learned AI blend (curation/aiBlend.ts).
  curatorProbability Float?

  @@index([createdAt])
  @@index([tokenId, createdAt])
  @@index([decision, createdAt])
  @@index([candidateOutcomeId])
  @@index([curatedAlertId])
}

model CuratorModel {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  /// The contestant this model plays as (curation/contestants.ts). Null on rows from before the
  /// contest, when one model at a time held the job.
  contestant   String?
  /// Model family + featurization version, e.g. "weighted-logistic-v1". A reader that doesn't
  /// recognize the kind must ignore the row rather than guess at params.
  kind         String
  /// Everything needed to score a candidate: feature names, standardization stats, weights,
  /// bias, emission threshold. Shape is owned by packages/core/src/curation/trainer.ts.
  params       Json
  trainingRows Int
  trainingFrom DateTime
  trainingTo   DateTime
  /// The walk-forward folds this model was judged on, plus the promotion verdict - the public
  /// evidence behind "the model took over" (or didn't).
  evalMetrics  Json
  /// active: the contestant's current model, calling on its ledger (one per contestant; before
  /// the contest, the one model holding the job). candidate: a pre-contest model that was
  /// evaluated but not promoted. retired: superseded by a newer run.
  status       String
  activatedAt  DateTime?
  retiredAt    DateTime?

  @@index([status, createdAt])
  @@index([contestant, status, createdAt])
}

/// One recipe's tenure in a learner seat of the curator contest (curation/evolution.ts). The seat
/// (`slot`, a contestant id) is the stable ledger key; the lane is what holds it: name, recipe,
/// lineage. A lane is current while retiredAt is null - at most one per slot, kept so by the
/// training job's transaction. Retired lanes stay as the evolution history.
/// The default model over time: the leaderboard's best performer, re-chosen after each training
/// run (curation/champion.ts). The newest row is the current default; a row is added only when
/// the pick changes.
model CuratorChampion {
  id         String   @id @default(cuid())
  contestant String
  /// Its display name when chosen (an evolved seat may since have been renamed).
  name       String
  /// Composite score (0-100) when chosen; null when the fallback rule chose.
  score      Float?
  /// Graded live calls in the window when chosen.
  liveGraded Int      @default(0)
  previous   String?
  reason     String
  chosenAt   DateTime @default(now())

  @@index([chosenAt])
}

model CuratorLane {
  id            String    @id @default(cuid())
  slot          String
  name          String
  description   String
  /// The CuratorRecipe it trains (curation/contestants.ts).
  recipe        Json
  /// 0 for the founding recipes; otherwise unique and increasing.
  generation    Int
  parentName    String?
  /// Its exam score in the run that seated it.
  examScore     Float?
  bornAt        DateTime  @default(now())
  retiredAt     DateTime?
  /// Why it lost the seat (the takeover's evidence).
  retiredReason String?

  @@index([slot, retiredAt])
  @@index([bornAt])
}

/// A challenger that won a learner seat on the exam, waiting to be confirmed on decision moments
/// that arrive after it was bred (curation/probation.ts). Both models are frozen as they stood in
/// the run that picked it. At most one is pending (resolvedAt null) at a time.
model CuratorProbation {
  id               String    @id @default(cuid())
  slot             String
  name             String
  description      String
  /// The challenger's CuratorRecipe, seated (and retrained) if it is confirmed.
  recipe           Json
  generation       Int
  parentName       String?
  /// Its exam score, and the in-run evidence that won it probation.
  examScore        Float?
  reason           String
  challengerParams Json
  laneParams       Json
  laneName         String
  startedAt        DateTime  @default(now())
  resolvedAt       DateTime?
  /// "confirmed", "rejected" or "abandoned".
  outcome          String?
  resolvedReason   String?

  @@index([resolvedAt])
  @@index([startedAt])
}

/// One training sample for the curated-alerts learner: a rug-screen-passing candidate at a
/// moment in time ("the anchor"), plus what its price actually did over the following hour.
/// Written for EVERY scored candidate - not just ones a user filter matched - because a model
/// trained only on user-selected tokens can never learn anything outside the box users already
/// drew. At most one row per token per CANDIDATE_SAMPLE_SPACING_MINUTES, so a token that sits in
/// the mcap band all day yields decorrelated samples rather than sixty near-identical ones an
/// hour. See packages/core/src/curation/ for the label math and feature contract.
model CandidateOutcome {
  id      String @id @default(cuid())
  tokenId String
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  /// The moment the label is measured FROM - "if the curator had alerted right now".
  anchorAt       DateTime  @default(now())
  /// The base every label is graded from: the price the token was detected and alerted at (the
  /// scan price). Label-rule-2 rows (2026-10-03 to 10-05) moved it to a "realistic fill"; the
  /// 20261005080000 migration moved them back.
  anchorPriceUsd Float
  anchorMcapUsd  Float
  /// When the watcher first priced the row (inside the win window). Null until then; a row with
  /// no price inside the win window closes ungraded.
  entryAt        DateTime?
  /// The scan price, stamped when the row is first priced (equal to anchorPriceUsd).
  signalPriceUsd Float?
  /// How the row came to be sampled - the trainer and the cutoff calibration care which:
  ///  - "hourly": the background sample, at most once per CANDIDATE_SAMPLE_SPACING_MINUTES.
  ///  - "event": the first scan in each CANDIDATE_EVENT_SPACING_MINUTES window where the token
  ///    looked ready (passesEventPreGate). The live curators decide ONLY at these moments, so
  ///    these rows are exactly the distribution live picks come from.
  ///  - "second": a second look the scan takes when TokenSage's deep read lands after the
  ///    token's last decision moment (same pre-gate, same spacing). Only the Narrative seat
  ///    decides here, and only it trains on these rows (curation/contestants.ts).
  ///  - "emission": a fresh anchor made for an alert or shadow pick. Chosen by a curator, so
  ///    kept out of training (a model learning from its own picks feeds back on itself).
  ///  - "match": the anchor a user-filter alert (Match.candidateOutcomeId) is graded from, shared
  ///    by every match of the token within MATCH_SAMPLE_SPACING_MINUTES. Chosen by users'
  ///    filters, so kept out of training too.
  sampleKind     String    @default("hourly")
  /// Which grading rule the labels follow (LEGACY_LABEL_RULE / CURRENT_LABEL_RULE in
  /// curation/labels.ts): 1 = the scan price under the old 1-hour rule (before 2026-10-03),
  /// 2 = a realistic fill (2026-10-03 to 10-05, re-graded to 3 where the aggregates allow),
  /// 3 = the alert price. The trainer down-weights older rules and the exam grades rule 3 only.
  labelRule      Int       @default(3)

  /// The feature vector at the anchor, as {name: number|null} - a denormalized copy of what the
  /// snapshot knew, NOT a snapshot reference, so training data outlives the 30-day
  /// TokenSnapshot purge without forcing snapshots to live 6 months. Names are the stable
  /// contract in packages/core/src/curation/features.ts; null means "genuinely unknown at
  /// anchor time" (the trainer turns those into missing-value indicators, never fake zeros).
  features Json
  /// The heuristic composite score at anchor. Also inside `features`; duplicated as a real
  /// column so stats queries can aggregate on it without unpacking JSON.
  score    Float?

  // ---- Watch state (driven by apps/worker/src/jobs/candidateOutcomeJob.ts) ----
  /// When the watcher should next price-check this row. Advances every tick whether or not
  /// DexScreener returned a price, so a dead pair can't hot-loop the sweep.
  nextCheckAt   DateTime
  lastCheckedAt DateTime?
  lastPriceUsd  Float?
  /// Whether this row keeps being watched past the 30-minute label window, out to 24h - set for
  /// clean winners (to record how far they ultimately ran: the run peak) and for rows a curated
  /// alert points at (their public outcome badge shows the 24h peak). Everything else stops when
  /// the label window closes: a dud's 24h peak teaches nothing the window didn't.
  extended24h   Boolean   @default(false)

  // ---- Running aggregates, initialized to the anchor price at creation ----
  /// Highest price seen within the label window (30 minutes since 2026-10-05, 1 hour before; the
  /// "1h" in this and the other column names predates the change).
  peak1hPriceUsd            Float
  peak1hAt                  DateTime?
  /// Lowest price seen within the label window - the worst drawdown a buyer at the anchor endured.
  low1hPriceUsd             Float
  /// Lowest price seen BEFORE the first observed 2x - frozen the tick the price first reaches
  /// 2x the anchor. This is what decides disqualification: a token that dropped 50%+ and then
  /// "2x'd from the bottom" stopped out anyone who actually bought the alert.
  lowBefore2xPriceUsd       Float
  /// First tick at which price >= 2x anchor was observed, anywhere inside the label window. The
  /// WIN test is this landing inside the 15-minute win window (see curation/labels.ts).
  hit2xAt                   DateTime?
  /// Highest price seen over the whole watch (up to 24h for extended rows).
  peak24hPriceUsd           Float
  peak24hAt                 DateTime?
  /// The label window's highest price before it first fell to the stop, frozen at that moment -
  /// what the 4x and labelValue are graded on (see cleanPeakPriceUsd in curation/labels.ts). Null
  /// on rows from before it was tracked.
  peakBeforeStopPriceUsd    Float?
  stoppedAt                 DateTime?
  /// The same pair over the 10x tier's hour (60 minutes from the alert): the 10x is graded on
  /// this. Null on rows from before the tier existed (2026-10-06), which are never graded for it.
  peakBeforeStop60mPriceUsd Float?
  stopped60mAt              DateTime?
  /// The exit plan's trailing exit (applyTrailTick in curation/profitSim.ts): the highest price
  /// since the plan's first sale (null until it sold, before the stop), and when the trail fired
  /// and the price it sold at (the price seen under its level; the level itself before
  /// 2026-10-07 20:30 UTC). Kept through the extended watch; a row with an open trailing share
  /// stays on watch until the exit or the plan's hold cap.
  trailHighPriceUsd         Float?
  trailExitAt               DateTime?
  trailExitPriceUsd         Float?

  // ---- Labels, written once when the goal window closes ----
  finalizedAt      DateTime?
  /// (peak1h - anchor) / anchor * 100.
  peak1hReturnPct  Float?
  /// (low1h - anchor) / anchor * 100 - zero or negative.
  maxDrawdown1hPct Float?
  /// Doubled inside the first 15 minutes. The same test as hit2xIn1h since 2026-10-05.
  hit2xIn15m       Boolean?
  /// THE bar: doubled inside the 15-minute win window (the name predates it; it was one hour
  /// until 2026-10-05). This is what "won" means for the feed, the stats, and (via labelValue)
  /// the learner - see curation/labels.ts.
  hit2xIn1h        Boolean?
  /// The goal: a win that reached 4x inside the 30-minute goal window (the name predates it).
  hit4xIn1h        Boolean?
  /// The third tier: a clean win that reached 10x within an hour, before the stop. Null while a
  /// clean winner's hour is still open (it is on the extended watch), and on rows that don't track
  /// it; see tenXVerdict in curation/labels.ts.
  hit10xIn1h       Boolean?
  /// Hit 2x inside the win window, but only after first dropping through the disqualifying
  /// drawdown - see lowBefore2xPriceUsd. Disqualified rows train as losses.
  disqualified     Boolean?
  /// The training target: 0 unless the row cleanly doubled within 15 minutes, else log2 of the
  /// label window's peak multiple, capped - a 2x is 1.0, the 4x goal is 2.0. See
  /// computeOutcomeLabels in curation/labels.ts.
  labelValue       Float?
  /// Set when the row is completely done (when the label window closes for non-extended rows,
  /// at 24h for extended ones).
  finalized24hAt   DateTime?
  /// The run peak: the highest price over the whole watch, as a return on the fill. For clean
  /// winners this is how far the token ultimately went after the call.
  peak24hReturnPct Float?
  /// Minutes from the alert to the run peak (peak24hAt). Written with peak24hReturnPct.
  runPeakMinutes   Float?
  /// Simulated return of the call under the fixed exit plan (EXIT_PLAN in curation/profitSim.ts:
  /// half at 2x, the rest on a trailing exit out at 3 hours, stop at -50% before the sale, a call
  /// that never sold closes at 30 minutes; rows graded before 2026-10-07 sold the rest at 4x and
  /// closed at 30 minutes, 1 hour before 2026-10-05), in percent of the stake. Written when the
  /// position is fully out: at the window close for a call that stopped or never sold, at the
  /// trailing exit or the hold cap for one that sold. Null until then, when ungraded, or when the
  /// close price is unknown.
  simReturnPct     Float?

  curatedAlerts   CuratedAlert[]
  shadowEmissions CuratedShadowEmission[]
  aiReviews       AiReview[]

  // No (tokenId, anchorAt) index: every per-token lookup also names the sampleKind, and the
  // three-column index below serves plain tokenId probes (cleanup, the FK) through its prefix.
  @@index([tokenId, sampleKind, anchorAt])
  @@index([sampleKind, anchorAt])
  @@index([finalized24hAt, nextCheckAt])
  @@index([anchorAt])
  @@index([finalizedAt])
}

/// A point-in-time reading of a token's market + on-chain state, produced each scan cycle.
model TokenSnapshot {
  id      String @id @default(cuid())
  tokenId String
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  takenAt DateTime @default(now())

  priceUsd          Float
  marketCapUsd      Float
  liquidityUsd      Float?
  volume24hUsd      Float?
  volumeToMcapRatio Float?
  buys24h           Int?
  sells24h          Int?

  // Short-window market data, from the same DexScreener pair response the 24h figures come from
  // (its priceChange/volume/txns objects carry m5/h1/h6 buckets alongside h24 - free to capture,
  // dropped for the pipeline's whole first year). These are the momentum signals: for a
  // 45-minute-old token, "24h volume" is lifetime volume, and a token that pumped all morning
  // but has been dumping for 15 minutes still shows a strong 24h buy ratio. The last hour is
  // what predicts the next one. Null on rows from before these existed, or when DexScreener
  // omits a bucket.
  priceChange5mPct  Float?
  priceChange1hPct  Float?
  priceChange6hPct  Float?
  priceChange24hPct Float?
  volume5mUsd       Float?
  volume1hUsd       Float?
  buys5m            Int?
  sells5m           Int?
  buys1h            Int?
  sells1h           Int?

  holderCount         Int?
  holderGrowthPct     Float?
  top10HolderPct      Float?
  devWalletPct        Float?
  // RugCheck's own composite risk score/named flags - stored raw (not just baked into
  // rugScreenPassed) now that a user can filter on them directly. See rugScreen.ts's
  // CRITICAL_RISK_FLAGS for which named flags matter to excludeCriticalRiskFlags.
  riskScore           Float?
  riskFlags           String[] @default([])
  // % of the (pool-excluded) top-10 holders whose wallet was funded <24h ago - a sniper/insider
  // signal. Null whenever there was no holder list to check (e.g. RugCheck hadn't indexed the
  // mint) or part of the list was deferred by the per-cycle Helius lookup budget - see
  // apps/worker/src/jobs/walletFreshness.ts. Deliberately null rather than 0 in every one of
  // those cases: 0 would claim we checked the full list and found none fresh.
  freshTop10WalletPct Float?
  // % of the top-10 holder list holding under WALLET_HOLDINGS_MIN_USD of tokens that are neither
  // cash nor gas. Null under exactly the same conditions as freshTop10WalletPct above, plus one
  // more: an endpoint that doesn't serve the DAS API can't answer it at all.
  emptyTop10WalletPct Float?
  // How many holders the two percentages above were computed over. The list is "top 10" by
  // intent, not by guarantee - pool and LP addresses are excluded from it - so a card that wants
  // to say "4 of 10" needs the real denominator rather than assuming ten. Null on snapshots
  // written before this column existed, and on any snapshot with no holder list at all.
  top10WalletsChecked Int?
  // Of the first 25 wallets to buy after launch (the dev aside), how many still hold it, out of
  // firstBuyersSeen (under 25 only while the launch has had fewer buyers). From the worker's
  // PumpPortal trade stream (curation/tradeFlow.ts), so null for a launch it didn't see.
  firstBuyersHolding  Int?
  firstBuyersSeen     Int?
  // Whether the dev still holds the token (resolveDevHolding: the trade stream's view of the dev's
  // bag, else RugCheck's creator balance). Null when neither knew.
  devHolding          Boolean?
  // Whether the mint was launched in Pump.fun's Mayhem Mode - an automatic, non-optional
  // rejection (see rugScreen.ts). Recorded here so the Admin Live Feed can show *why* a token
  // was screened out. Null means the check never ran or failed, which the screen also rejects.
  isMayhemMode        Boolean?
  // Whether the mint has graduated off a Pump.fun bonding curve to a real AMM, derived from
  // DexScreener's dexId (see dexscreener.ts's deriveGraduated) - null for anything DexScreener
  // hasn't indexed a pair for at all.
  graduated           Boolean?

  mintAuthorityActive   Boolean?
  freezeAuthorityActive Boolean?
  lpBurned              Boolean?

  /// Float, to sub-minute precision. Was Int, which meant a token 15 seconds old and one 40
  /// seconds old both recorded as "0" and "1" respectively - fine for display, useless for a
  /// filter that wants to distinguish them.
  ageMinutes Float?

  score             Float?
  // Individual components behind `score` (see packages/core/src/scoring/scorer.ts's
  // ScoreBreakdown) - persisted so the dashboard can show *why* a token scored the way it did,
  // not just the composite number. Nullable because snapshots taken before this field existed
  // won't have them.
  scoreMomentum     Float?
  scoreHolderHealth Float?
  scoreAge          Float?
  scoreNarrative    Float?

  rugScreenPassed  Boolean  @default(false)
  rugScreenReasons String[] @default([])

  /// Which job wrote this row: "scan" for the full enrichment cycle, "fast" for the 15-second
  /// match pass (see apps/worker/src/jobs/fastMatchJob.ts).
  ///
  /// Load-bearing, not bookkeeping. The fast pass carries the on-chain half of a token's profile
  /// FORWARD from the last scan rather than re-resolving it, so its rows restate a verdict rather
  /// than establishing one. When "has this token been vetted recently" was answered from all
  /// snapshots, every fast-pass write re-armed that window: a token whose scan verdict had since
  /// flipped to failing stayed alertable indefinitely, because its own fast rows kept looking
  /// fresh. Only "scan" rows count as vetting, so the window can only be extended by a pass that
  /// actually re-checked the chain.
  ///
  /// Defaults to "scan" so existing rows - all written before this column, the vast majority by
  /// the full cycle - keep their meaning.
  source String @default("scan")

  matches       Match[]
  curatedAlerts CuratedAlert[]

  // The only index the reads need: every query on this table is per token, newest first. There
  // is deliberately no index on takenAt or (source, takenAt) - the table is ~3GB and write-heavy,
  // so time-ranged work (cleanup, the fast-match fallback) walks Token first instead.
  @@index([tokenId, takenAt])
}

/// A token that matched a specific user's filter on a specific scan cycle.
model Match {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  filterId String
  filter   UserFilter @relation(fields: [filterId], references: [id], onDelete: Cascade)

  tokenId String
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  snapshotId String
  snapshot   TokenSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  matchedAt DateTime @default(now())
  score     Float

  deliveredDashboard Boolean @default(true)

  // Backtesting data: the highest market cap observed for this token since the match, tracked by
  // the outcome-tracking job (apps/worker/src/jobs/outcomeTrackingJob.ts). Both null until that
  // job's first run after the match. Baseline for "how far did it run" is snapshot.marketCapUsd
  // (the mcap at match time), not these fields - see outcomeTrackingJob.ts for why.
  peakMcapUsd     Float?
  peakMcapAt      DateTime?
  // (peakMcapUsd - snapshot.marketCapUsd) / snapshot.marketCapUsd * 100 - kept in step with
  // peakMcapUsd by the outcome-tracking job, which recomputes it whenever the peak rises AND
  // repairs it wherever the two have drifted apart (rows whose peak was recorded before this
  // column existed). Persisted rather than computed at read time so the Leaderboard can rank on
  // this column directly instead of pulling every Match ever created into memory to sort.
  peakReturnPct   Float?
  // Set once, as soon as the *recorded peak* is worth >= +100% (a 2x on the alert mcap) - never
  // touched again after that even as peakMcapUsd/peakReturnPct keep climbing on future highs.
  // Deliberately keyed off the recorded peak rather than off "this run saw a new high": a token
  // that 5x'd and then dumped has to stay eligible, and it is by definition never going to set
  // another high. Dated to peakMcapAt (when the qualifying peak was actually seen), not to the
  // run that noticed. Marks this match as eligible for the public Leaderboard; indexed so that
  // query never scans every Match - see apps/api/src/routes/leaderboard.ts.
  hitHundredPctAt DateTime?

  // The curated feed's verdict, applied to this alert: graded by the CandidateOutcome row
  // (sampleKind "match") anchored when the match was created - the realistic fill, the 15-minute
  // win window, the 30-minute goal window and the 50%-drop stop, exactly as curated alerts are
  // graded (the "1h" column names predate the windows). Copied over when that
  // row's window closes, in the same transaction, because outcome rows are pruned on
  // CANDIDATE_OUTCOME_RETENTION_DAYS. All null until then, and on matches from before this
  // existed.
  //
  // candidateOutcomeId is a plain column, not a relation, on purpose: an FK would make every
  // outcome-row prune look up Match by this column, and Match is the one table too large to
  // index online in a migration (see 20260903020000_snapshot_source_index). The watcher finds a
  // row's matches through the token, which IS indexed.
  candidateOutcomeId String?
  peak1hReturnPct    Float?
  maxDrawdown1hPct   Float?
  hit2xIn1h          Boolean?
  /// 4x inside the 30-minute goal window without the stop - false whenever disqualified.
  hit4xIn1h          Boolean?
  /// 10x within an hour of the alert without the stop - copied when the anchor's hour settles.
  hit10xIn1h         Boolean?
  /// Hit 2x only after first falling through the 50% stop: a loss.
  disqualified       Boolean?
  /// The run peak over the anchor's watch (24h for clean winners, the label window otherwise), as a
  /// return on the alert price: copied when the anchor retires, so the filter leaderboard's run-size
  /// part outlives the anchor row. Null until then, and on matches from before 2026-10-05.
  peak24hReturnPct   Float?

  @@unique([userId, tokenId, filterId, matchedAt])
  @@index([userId, matchedAt])
  @@index([tokenId])
  // Cascade foreign keys: deleting a filter, or the nightly snapshot cleanup, scanned all of Match
  // per deleted row without these.
  @@index([filterId])
  @@index([snapshotId])
  @@index([hitHundredPctAt, peakReturnPct])
  // The match-peaks pass repairs rows by "peak recorded in the last few minutes" every cycle, and
  // the peak passes pick matches by matchedAt; both scanned all of Match, which is never pruned.
  @@index([peakMcapAt])
  @@index([matchedAt])
}

/// Caches a wallet's earliest-ever transaction timestamp, keyed by address - not scoped to any
/// one Token, since the same wallet can legitimately show up as a top holder on many different
/// mints. This is Helius's single most expensive per-address call (getSignaturesForAddress with
/// limit 1000) and the answer never changes once known, so re-fetching it for a wallet we've
/// already seen - whether on a later scan cycle or as a top holder of a different token in the
/// same cycle - is pure waste. See apps/worker/src/jobs/walletFreshness.ts for how this is
/// populated and read.
model WalletActivityCache {
  address String @id

  /// Null means "we asked and the answer is genuinely indeterminate" - no signatures at all, or a
  /// full getSignaturesForAddress page meaning older history exists beyond it. That's a real,
  /// final answer worth remembering, since re-asking the same unanswerable question every cycle
  /// would be exactly the waste this table exists to avoid.
  ///
  /// Crucially, a row is only ever written for a DEFINITIVE result. A lookup that failed in
  /// transit (timeout, rate limit, RPC error) writes nothing at all, so a transient Helius blip
  /// can't permanently poison a wallet as "indeterminate" - see EarliestActivityResult's
  /// "failed" case in helius.ts and resolveEarliestActivity in walletFreshness.ts.
  earliestActivityAt DateTime?
  checkedAt          DateTime  @default(now())

  /// Supports the cleanup job's retention sweep - without it that DELETE full-scans a table
  /// that grows one row per distinct wallet ever seen.
  @@index([checkedAt])
}

/// Per-wallet USD value of holdings that are neither cash (USDC/USDT) nor gas (SOL) - the input
/// to the empty-top-10-wallet signal.
///
/// Unlike WalletActivityCache, whose answer is immutable once known (a wallet's first-ever
/// transaction never changes), THIS answer decays: a portfolio changes with every trade. So rows
/// carry a TTL (env WALLET_HOLDINGS_CACHE_TTL_MINUTES) and are refreshed rather than trusted
/// forever, which also means the hit rate here is structurally lower than the activity cache's.
/// What still makes it pay is overlap: the same wallets recur as top holders across many
/// different launches within any one TTL window.
model WalletHoldingsCache {
  address String @id

  /// A FLOOR on the wallet's non-cash holdings, in USD - assets the indexer had no price for
  /// contribute nothing. See getOtherHoldingsUsdBatch in datasources/helius.ts. Only ever
  /// written for a definitive answer; a failed lookup writes no row at all.
  ///
  /// Still INCLUDES whatever the wallet holds of any given launch: the per-launch subtraction
  /// happens at read time out of perMintUsd, which is what lets one reading serve every candidate
  /// this wallet holds instead of needing a row per (wallet, launch) pair.
  otherHoldingsUsd Float

  /// { mint: usd } for the launches this wallet was checked against, zeroes included. A row can
  /// only answer the empty-wallet question for a mint that appears here - see the note on
  /// WalletHoldingsResult.perMintUsd. Empty object on rows written before this column existed,
  /// which simply makes them a miss for every candidate rather than a wrong answer.
  perMintUsd Json @default("{}")

  /// perMintUsd lists every priced holding, so a launch absent from it is a known zero and the
  /// row can answer for launches the wallet turns up on later - see
  /// WalletHoldingsResult.complete. False on older rows and on wallets too big to list in full.
  breakdownComplete Boolean @default(false)

  checkedAt DateTime @default(now())

  /// Serves both the TTL sweep and the cleanup job's retention sweep.
  @@index([checkedAt])
}

/// Caches mints whose mint AND freeze authorities are both already revoked - the one state that
/// is permanently, irreversibly safe, so a row here is never re-checked or invalidated.
///
/// Deliberately one-directional: revocation can't be undone, but the reverse absolutely happens -
/// a creator who still holds an active authority today can renounce it tomorrow (one of the most
/// common ways a memecoin signals legitimacy). Caching THAT state would permanently fail a token
/// that later became safe, so an unrevoked mint simply gets no row and is re-checked next cycle.
/// Both columns are stored (rather than implied) so the row is self-describing on inspection.
///
/// Only populated on the fallback path where RugCheck has no report for a mint - see
/// resolveMintAuthorities in apps/worker/src/jobs/mintAuthority.ts.
model MintAuthorityCache {
  mintAddress String @id

  mintAuthorityActive   Boolean
  freezeAuthorityActive Boolean
  checkedAt             DateTime @default(now())

  /// Same reason as WalletActivityCache.checkedAt - see the cleanup job's retention sweep.
  @@index([checkedAt])
}

/// Caches whether a mint was launched in Pump.fun's Mayhem Mode, detected by the existence of its
/// `["mayhem-state", mint]` PDA (see mayhemStateAddress() in packages/core/src/solana.ts).
///
/// Unlike MintAuthorityCache, BOTH answers are cached permanently: Mayhem Mode is chosen at launch
/// and cannot be added to or removed from an existing token, so neither a true nor a false can go
/// stale. Only definitive results are written - a lookup that errored stores nothing and is
/// retried, since the rug screen rejects unverified mints and a cached wrong answer would be
/// indistinguishable from a real one.
/// Short-lived cache of RugCheck's per-mint report.
///
/// Unlike MayhemModeCache/MintAuthorityCache, what RugCheck reports is genuinely mutable - holder
/// distribution, dev wallet %, and the composite risk score move constantly - so this is a TTL
/// cache (RUGCHECK_CACHE_TTL_MINUTES), never a permanent one.
///
/// It exists so the scan cadence and the RugCheck request rate can be set independently. RugCheck
/// is called once per in-band candidate per cycle and is the only upstream with no cache at all,
/// which made it, not our own compute, the thing pinning SCAN_INTERVAL_MINUTES. With this, a
/// one-minute scan re-requests a mint at most every TTL minutes, so most cycles only pay for
/// candidates that are newly in band.
///
/// `profile` null means RugCheck genuinely has no report for this mint yet (a 404 - very new
/// token), which is worth caching so those mints aren't re-requested every cycle either. A
/// transport failure is never written here at all - see resolveRugProfiles.
model RugCheckCache {
  mintAddress String   @id
  profile     Json?
  checkedAt   DateTime @default(now())

  @@index([checkedAt])
}

/// TokenSage's read of what a mint is about (its referent, narrative categories, copycat signals,
/// X link and trend matches) - one row per mint, written by apps/worker/src/tokensage/prefetch.ts
/// when TOKENSAGE_ENABLED is on. `depth` is the deepest analysis stored ("basic" or "full"); a
/// row is replaced when a deeper one arrives. `analysis` keeps the whole Analysis document so new
/// model inputs can be derived from history later without asking TokenSage again.
///
/// `status` "failed" with a null `analysis` caches a definitive answer (unknown mint, not a token)
/// so it is not re-requested every cycle. Transport failures are never written here.
model TokenNarrative {
  mintAddress           String    @id
  depth                 String
  status                String
  /// Top-level and sub-category labels with confidences, e.g. [{"label":"animal/dog","confidence":0.9}].
  categories            Json?
  referentLabel         String?
  referentKind          String?
  summary               String?
  /// Flag codes, e.g. ["copycat","x_link_reused"].
  flags                 String[]  @default([])
  /// How well the linked X post/profile matches the token (TokenSage's x.match, full depth):
  /// fit 0-1 and verdict "about_this_coin" / "related" / "unrelated". Null when not read or
  /// "unknown" (nothing fetched), which is missing data, not a mismatch.
  xFit                  Float?
  xVerdict              String?
  /// referent.confidence and referent.supported_by (the inputs pointing at it, e.g. ["name","x"]).
  referentConfidence    Float?
  referentSupport       String[]  @default([])
  /// TokenSage rules 0.17.0+: only the referent's kind is known (referent.generic; "frog", not
  /// a named frog). False on a named referent, null without one or on older rules.
  referentGeneric       Boolean?
  /// market.pair: what the coin trades against ("sol", "stablecoin", "token", "tokenized_stock", ...).
  pairKind              String?
  pairSymbol            String?
  /// Copies a coin launched in the last 30 days (copy_of[].recent). Null on analyses from before
  /// TokenSage rules 0.10.0, which didn't say.
  copiesRecent          Boolean?
  /// The linked X post, when the full read opened it (x.status "ok"): how it relates to the coin
  /// ("launch_announcement", "official_account", "narrative_reference", "spoofed", ...), its
  /// author's followers, how many seconds it predates the token, and how many other coins link
  /// the same post. All null when the post was not read.
  xRelation             String?
  xAuthorFollowers      Int?
  xPredatesTokenS       Int?
  xReuseCount           Int?
  /// The name matched a Wikipedia/news spike (trend.matched, full depth); null until read.
  trendMatched          Boolean?
  /// TokenSage rules 0.15.0+: which copy of what this coin is (lineage.kind "original",
  /// "early_copy", "copy", "late_copy", "reference", "unknown"), its launch-order rank among its
  /// namesakes, the coin it copies and that coin's age and curve state at the read, how many
  /// coins shared its name, ticker or logo in the hours before it, and how many coins TokenSage
  /// resolved to the same referent (the wave). All null on reads made by older rules.
  lineageKind           String?
  lineageRank           Int?
  lineageRankOf         Int?
  lineageOfMint         String?
  originalAgeS          Int?
  originalCurveProgress Float?
  originalComplete      Boolean?
  siblings1h            Int?
  siblings6h            Int?
  siblings24h           Int?
  logoReuse24h          Int?
  waveLaunches1h        Int?
  waveLaunches6h        Int?
  waveLaunches24h       Int?
  waveRank24h           Int?
  /// How many inputs (name, symbol, description, image, x, trend, db) agree on the top category.
  topCategoryInputs     Int?
  /// The linked X account's worth apart from its fit (x.credibility 0-1), its age at the coin's
  /// launch, whether it was made for the coin, and this coin's place among the coins linking it.
  xCredibility          Float?
  xAccountAgeS          Int?
  xAccountMadeForCoin   Boolean?
  xReuseRank            Int?
  /// Strength of the trend hit (trend.score 0-1); null until read or on older rules.
  trendScore            Float?
  /// Flags by severity, so the models and score need no catalogue of codes.
  highFlagCount         Int       @default(0)
  warnFlagCount         Int       @default(0)
  /// Why the analysis failed, on status "failed" rows.
  failReason            String?
  rulesVersion          String?
  /// versions.lexicon: TokenSage's category lexicon, which moves without a rules bump.
  lexiconVersion        String?
  analysis              Json?
  analyzedAt            DateTime?
  checkedAt             DateTime  @default(now())

  @@index([checkedAt])
}

/// The Market Lighthouse's history: one row per UTC hour, written by the hourly rollup
/// (apps/worker/src/jobs/lighthouseRollupJob.ts) and kept for good. The rows it is summed from -
/// CandidateOutcome (CANDIDATE_OUTCOME_RETENTION_DAYS), TokenNarrative (the RPC-cache horizon) -
/// are swept after weeks, so this is what the Lighthouse tab's trends over months read. Sums and
/// counts only, never rates, so any span of hours adds up; a few hundred bytes a row.
model LighthouseHour {
  hour DateTime @id

  /// Screened decision moments: the "event" CandidateOutcome rows anchored in the hour, graded the
  /// way the stats route grades them (a 2x after the stop is a loss).
  screenedCalls      Int   @default(0)
  screenedGraded     Int   @default(0)
  screenedWon2x      Int   @default(0)
  screenedWon4x      Int   @default(0)
  screenedWon10x     Int   @default(0)
  /// Rows whose 10x verdict is in: the 10x rate's denominator.
  screenedTenXGraded Int   @default(0)
  /// Rows with a return under the exit plan, and their returns summed (percent of the stake).
  screenedReturnN    Int   @default(0)
  screenedReturnSum  Float @default(0)

  /// TokenSage reads checked in the hour.
  readsTotal            Int   @default(0)
  readsDescribed        Int   @default(0)
  readsDeep             Int   @default(0)
  readsFailed           Int   @default(0)
  referentConfidenceSum Float @default(0)
  referentConfidenceN   Int   @default(0)
  xFitSum               Float @default(0)
  xFitN                 Int   @default(0)
  copiesRecent          Int   @default(0)
  copiesAnswered        Int   @default(0)
  trendMatched          Int   @default(0)
  trendAnswered         Int   @default(0)

  /// The models' calls (CuratedAlert) made in the hour, and how they graded.
  alerts           Int   @default(0)
  alertsDescribed  Int   @default(0)
  alertsGraded     Int   @default(0)
  alertsWon2x      Int   @default(0)
  alertsWon4x      Int   @default(0)
  alertsWon10x     Int   @default(0)
  /// Calls whose 10x verdict is in (a loss at 2x settles it at once): the 10x rate's denominator.
  alertsTenXGraded Int   @default(0)
  alertsReturnN    Int   @default(0)
  alertsReturnSum  Float @default(0)

  computedAt DateTime @default(now())
}

/// The Lighthouse's label breakdowns per UTC day: how many coins TokenSage read under each
/// narrative, flag, referent kind and so on, and how the models' calls on those coins graded.
/// Same rollup and the same keep-for-good rule as LighthouseHour.
model LighthouseDayLabel {
  day        DateTime
  /// "category" (the top-level narrative each coin is surest of, one per coin), "subcategory",
  /// "flag", "referentKind", "referentSupport", "xVerdict", "pairKind", "copy", "news".
  dimension  String
  label      String
  /// Coins read under the label that day.
  count      Int      @default(0)
  /// Model calls on coins carrying the label, and how they graded.
  alerts     Int      @default(0)
  graded     Int      @default(0)
  won2x      Int      @default(0)
  won4x      Int      @default(0)
  won10x     Int      @default(0)
  tenXGraded Int      @default(0)

  @@id([day, dimension, label])
}

model MayhemModeCache {
  mintAddress String @id

  isMayhemMode Boolean
  checkedAt    DateTime @default(now())

  /// Supports the cleanup job's retention sweep, same as the other RPC caches. The horizon is
  /// about bounding storage rather than staleness - see RPC_CACHE_RETENTION_DAYS.
  @@index([checkedAt])
}

/// How a user came to have access to the Trenches dashboard.
enum AccessSource {
  /// Paid for by burning $ASDFASDFA - see BurnEvent.
  BURN
  /// Granted by hand from the Admin Panel, e.g. to make good on a burn that couldn't be
  /// attributed automatically.
  ///
  /// There is deliberately no WHITELIST member: a whitelisted wallet never gets a Subscription
  /// row at all - resolveAccess() answers for it directly - so a value that could never be
  /// written would just be a state readers have to rule out by hand.
  ADMIN_GRANT
}

/// A user's paid access window.
///
/// One row per user, extended rather than replaced: a renewal moves `expiresAt` forward from
/// whichever is later, now or the current expiry, so buying a second month early stacks instead of
/// throwing away what's left of the first.
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  /// What most recently extended this window. Not an audit trail - BurnEvent is.
  source    AccessSource

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

/// One on-chain burn of the subscription token, whether or not we have a user for it yet.
///
/// This is the ledger, and the chain is its source of truth: every burn the reconciler finds gets
/// a row, including burns from wallets that have never signed in (userId null). A burn is credited
/// exactly once - `signature` is unique, which is what makes both the claim endpoint and the
/// reconciler safe to retry and safe to run at the same time.
model BurnEvent {
  id String @id @default(cuid())

  /// The transaction signature. UNIQUE: this is the replay guard. Two concurrent claims for the
  /// same burn race to insert, one wins, and the loser is handled as "already credited" rather
  /// than as an error.
  signature String @unique

  /// Slot and block time as reported on-chain. blockTime is nullable because Solana does not
  /// guarantee it for older transactions.
  slot      BigInt
  blockTime DateTime?

  /// The wallet whose tokens were burned: the owner of the token account on the burn instruction
  /// (its `authority` when the transaction carries no token balances to resolve the owner from).
  /// A delegate may sign the burn, but the tokens were the owner's, so the month is theirs
  /// (decided 2026-10-07).
  burnerWallet String
  mint         String

  /// Base units (this mint has 6 decimals, so 55200 tokens = "55200000000"). Stored as a string
  /// and compared as BigInt: a float would silently lose precision on large burns, and there is no
  /// good reason to let a rounding error decide whether someone paid.
  rawAmount String

  monthsCredited Int

  /// Null until a User exists for burnerWallet - someone can burn before they ever sign in, and
  /// their months are waiting when they do.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// When this burn was turned into subscription time. Null means found but not yet credited,
  /// which for an unattributed burn is the normal resting state.
  creditedAt DateTime?

  /// Which path found it - "claim" (the user told us) or "reconciler" (we found it ourselves).
  discoveredBy String @default("reconciler")

  createdAt DateTime @default(now())

  @@index([burnerWallet])
  @@index([userId])
  @@index([creditedAt])
}

/// Wallets that get in free, managed from the Admin Panel.
///
/// Keyed by wallet rather than by user id so a wallet can be whitelisted before it has ever signed
/// in - which is the usual case, since you whitelist someone by pasting their address.
model Whitelist {
  walletAddress String @id

  /// Null means indefinite. A date lets you hand out a trial without having to remember to revoke.
  expiresAt DateTime?
  note      String?
  /// Wallet address of the admin who added it, for the audit trail.
  addedBy   String

  createdAt DateTime @default(now())
}

/// Where the burn reconciler got to, so each pass only walks what it hasn't seen.
///
/// A single row (id "burn-scan"). Kept in its own table rather than in SystemHeartbeat.meta
/// because losing it silently would mean silently missing burns - it deserves a column, not a
/// corner of a JSON blob.
model BurnScanCursor {
  id String @id @default("burn-scan")

  /// The newest signature fully processed. The next pass walks backwards from the tip until it
  /// reaches this, then stops. Null on a fresh install, which triggers a bounded first scan.
  lastSignature String?
  /// How far back a cold start is allowed to look, so a fresh deploy doesn't walk all history.
  /// Held until the backfill below has actually reached it, then cleared.
  scanFloor     DateTime?

  /// Where the cold-start backfill has walked back to, when one pass could not reach scanFloor.
  ///
  /// A pass is capped at MAX_PAGES_PER_PASS pages, and the default 400-day floor is roughly twice
  /// that many signatures at this mint's measured rate - so the first pass stops short. It used
  /// to stop short and then set lastSignature to the tip, which pointed every later pass at only
  /// what was NEWER: the older half of the window was jumped over and never visited again, and a
  /// burn sitting in it could not be credited by anything. This is the resume point that makes
  /// the documented "walks across a few passes" true - each pass continues backwards from here
  /// until the floor is reached, then both this and scanFloor are cleared.
  backfillBefore String?

  updatedAt DateTime @updatedAt
}

/// The AI reviewer's playbook: lessons learned from its own graded record, appended to the fixed
/// system prompt. Exactly one is "active" (what the live reviewer runs with); evolution writes
/// "candidate" rows from a review of graded calls, replays them against the active one on recent
/// alerts the review never saw, and promotes a candidate only when it beats the incumbent
/// (apps/worker/src/ai/playbook.ts). Old rows are kept, so every verdict's playbook stays readable.
model AiPlaybook {
  id        String    @id @default(cuid())
  version   Int
  /// "active" | "candidate" | "retired" | "rejected"
  status    String
  text      String
  /// Why the review proposed this version - one or two sentences.
  rationale String?
  parentId  String?
  createdAt DateTime  @default(now())
  /// When it was promoted, retired or rejected.
  decidedAt DateTime?
  /// Its record on the replay that decided it (JudgeRecordSummary), for the Models tab.
  metrics   Json?

  @@index([status, createdAt])
}

/// One offline replay of the AI reviewer over past graded alerts, sent through the Message
/// Batches API: either a "baseline" run of the active playbook (to give it a record to learn
/// from) or an "evolution" run that pits candidate playbooks against it on the same alerts.
model AiReplayRun {
  id               String    @id @default(cuid())
  /// "baseline" | "evolution"
  purpose          String
  /// "submitted" | "scored" | "failed"
  status           String
  batchId          String?
  model            String
  /// The playbooks replayed, in custom_id order.
  playbookIds      String[]
  windowStart      DateTime
  windowEnd        DateTime
  requestCount     Int
  /// What the run was expected to cost when it was submitted (charged to the daily AI budget then),
  /// and what its results actually cost once they came back (the budget is trued up to this).
  estimatedCostUsd Float?
  costUsd          Float?
  createdAt        DateTime  @default(now())
  scoredAt         DateTime?
  /// Per-playbook JudgeRecordSummary, keyed by playbook id.
  metrics          Json?
  error            String?

  verdicts AiReplayVerdict[]

  @@index([status])
  @@index([purpose, createdAt])
}

/// One replayed verdict: what a playbook said about one past alert, graded by that alert's label.
model AiReplayVerdict {
  id                 String      @id @default(cuid())
  runId              String
  run                AiReplayRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  playbookId         String
  candidateOutcomeId String
  decision           String?
  probability2x      Float?
  probability4x      Float?
  error              String?
  inputTokens        Int?
  outputTokens       Int?

  @@index([runId])
  @@index([playbookId])
}

/// The learned AI blend (curation/aiBlend.ts): how much to trust the reviewer's 2x odds next to the
/// default model's own, fitted on graded reviews. The newest row is the one gate mode reads.
model AiBlendModel {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// AiBlendParams - weights, cutoff, and whether it earned the gate.
  params    Json
  /// AiBlendMetrics - rows, out-of-sample Brier for the blend and each input alone.
  metrics   Json

  @@index([createdAt])
}

/// A snapshot of every model the contest is running (curation/modelBackup.ts): each seat's active
/// CuratorModel (weights, cutoff, calibration, exam), its lane (recipe and lineage) and live record,
/// the default-model pick, and the AI reviewer's active playbook and blend. Kept apart from the live
/// tables on purpose: a training run retires every model it replaces, and the cleanup job strips a
/// retired model's weights a week later, so without this a good model's weights are gone for good.
/// Written weekly by the trainer (and on demand from the Admin tab); restorable from the Admin tab.
model ModelBackup {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  /// "weekly" | "manual" | "pre-restore" | "imported"
  kind         String
  note         String?
  /// Pinned backups are never pruned.
  pinned       Boolean   @default(false)
  modelCount   Int
  /// The gzipped ModelBackupPayload JSON - exactly the bytes the download serves.
  data         Bytes
  sizeBytes    Int
  /// sha256 (hex) of `data`, checked before any restore or download.
  sha256       String
  /// The off-site copy (MODEL_BACKUP_S3_*): its object key once uploaded, else the last error.
  offsiteKey   String?
  offsiteAt    DateTime?
  offsiteError String?
  restoredAt   DateTime?

  @@index([kind, createdAt])
  @@index([createdAt])
}

/// The AI's daily spend ledger, one row per UTC day and source ("review", "review-spare", "text",
/// "playbook", "replay"). Every Anthropic call reserves its estimated cost here before it runs and
/// is trued up to the real cost from its usage afterwards, so the scanner and trainer processes
/// share one AI_DAILY_BUDGET_USD. `refused` counts calls the budget turned away; `capUsd` is the
/// cap the worker was enforcing on its last write, so the API shows the worker's cap, not its own.
model AiSpend {
  day       String
  source    String
  costUsd   Float    @default(0)
  calls     Int      @default(0)
  refused   Int      @default(0)
  capUsd    Float
  updatedAt DateTime @default(now())

  @@id([day, source])
}

/// A message an admin posts from the Admin tab to every visitor's dashboard (signed in or guest).
/// One shows at a time: posting a new one ends the one before it. It stops showing once `endedAt`
/// is set (ended by hand or replaced) or `expiresAt` passes; old rows stay as the admin's history.
/// Visitors dismiss an announcement by its id, so a new one shows again.
model Announcement {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  message   String
  /// "info" | "warning"
  severity  String    @default("info")
  expiresAt DateTime?
  endedAt   DateTime?
  /// The admin wallet that posted it.
  createdBy String?

  @@index([createdAt])
}
