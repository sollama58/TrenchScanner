// TrenchScanner data model
// See PLANNING.md section 4 for the design rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AlertMode {
  REALTIME
  DIGEST
  BOTH
  OFF
}

/// One row per background job (scan, digest, cleanup, ...), updated on every run whether it
/// succeeds or fails. This is what lets the API/dashboard answer "is the worker actually alive"
/// without needing a separate monitoring service - see packages/core/src/heartbeat.ts.
model SystemHeartbeat {
  job           String    @id
  lastRunAt     DateTime
  lastSuccessAt DateTime?
  lastError     String?
  meta          Json?
  updatedAt     DateTime  @updatedAt
}

/// A person, identified by their Solana wallet (Sign-In With Solana).
model User {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  createdAt     DateTime @default(now())

  filters      UserFilter[]
  telegramLink TelegramLink?
  matches      Match[]
  subscription Subscription?
  burns        BurnEvent[]
}

/// Short-lived nonce a wallet must sign to authenticate. One-time use.
model AuthNonce {
  id            String    @id @default(cuid())
  walletAddress String
  nonce         String    @unique
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?

  @@index([walletAddress])
}

/// A saved filter configuration. A user may have more than one.
model UserFilter {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String @default("Default")
  mcapMin Float  @default(50000)
  mcapMax Float  @default(500000)

  minVolumeMcapRatio       Float? // volume24h / marketCap, momentum signal
  minHolderGrowthPct       Float? // % holder growth over the lookback window
  // These four used to be part of the mandatory automatic rug screen (packages/core/src/scoring/
  // rugScreen.ts) - different users legitimately want different thresholds here, unlike mint/
  // freeze authority or LP lock, so they moved to being opt-in criteria instead. Unset (null/
  // false) means "don't check this," not "reject unless known" - see matchFilters.ts.
  maxTop10HolderPct        Float? // top-10 holder concentration, %
  maxDevWalletPct          Float? // creator's own holding, % (only if they rank in the top 10)
  maxRiskScore             Float? // RugCheck's own composite risk score, 0-100 (higher = riskier)
  excludeCriticalRiskFlags Boolean  @default(false) // e.g. "Creator history of rugged tokens"
  /// Float, not Int: people filtering the very freshest launches think in seconds, and 0.25 is
  /// how you say fifteen of them without inventing a second unit. See TokenSnapshot.ageMinutes,
  /// which carries matching precision - a fractional bound compared against a whole-minute age
  /// would quietly round away and do nothing.
  minTokenAgeMinutes       Float?
  maxTokenAgeMinutes       Float?
  narrativeKeywords        String[] @default([])
  minScore                 Float? // minimum composite score, 0-100
  maxFreshTop10WalletPct   Float? // % of top-10 holders funded <24h ago (sniper/insider signal)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches Match[]

  @@index([userId])
}

/// A user's linked Telegram chat for alerts. Linking is a two-step flow: the API issues a
/// short-lived linkCode, the user sends "/start <linkCode>" to the bot (long-polled by the
/// worker - Render background workers have no inbound HTTP, so webhooks aren't an option),
/// and the worker fills in chatId/linkedAt and clears the code.
model TelegramLink {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  chatId    String?   @unique
  alertMode AlertMode @default(BOTH)

  linkCode          String?   @unique
  linkCodeExpiresAt DateTime?
  linkedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A distinct Solana token being tracked.
model Token {
  id            String   @id @default(cuid())
  mintAddress   String   @unique
  symbol        String?
  name          String?
  pairAddress   String? // primary DexScreener pair used for pricing
  /// The token's logo, as hosted by DexScreener. Read from the pair response the scan already
  /// fetches rather than derived from the mint address: CDN URL shapes are undocumented and
  /// change, and a guessed one 404s silently for every mint that has no artwork - which is a lot
  /// of them. Null means DexScreener has no image, not that we failed to look.
  imageUrl      String?
  firstSeenAt   DateTime @default(now())
  hasTwitter    Boolean  @default(false)
  hasTelegram   Boolean  @default(false)
  hasWebsite    Boolean  @default(false)
  narrativeTags String[] @default([])

  // Stamped by GET /matches (see apps/api/src/routes/matches.ts) whenever this token appears on
  // a page someone actually fetched - not per-user, just "is anyone currently looking at this."
  // The scan job (apps/worker/src/jobs/scanJob.ts) keeps re-scanning a token within
  // ACTIVE_VIEW_WINDOW_MINUTES of this timestamp even after it's dropped out of the mcap band,
  // so a genuine breakout winner someone has open doesn't go stale the moment it leaves the
  // MCAP_FILTER_MIN/MAX band - but a token nobody's looking at anymore is left alone once it's
  // out of band, rather than tracking every historical match forever.
  lastViewedAt DateTime?

  // A lightweight, display-only price ping for tokens someone currently has open, refreshed far
  // more often than a full scan cycle (see apps/worker/src/jobs/livePriceJob.ts). Deliberately
  // NOT a TokenSnapshot: a snapshot is a full point-in-time evaluation that feeds scoring,
  // matching and history, and minting one every minute purely to move a number on screen would
  // both bloat that table and attach stale on-chain/score data to fresh market data. These three
  // fields are the opposite - current market data with no claim to anything else. Null until the
  // first refresh; `liveDataAt` is what lets a reader tell whether this or the latest snapshot is
  // actually fresher (see currentMarketCap() in apps/api/src/routes/matches.ts).
  liveMarketCapUsd Float?
  livePriceUsd     Float?
  liveDataAt       DateTime?

  snapshots TokenSnapshot[]
  matches   Match[]
  candidateOutcomes CandidateOutcome[]
  curatedAlerts     CuratedAlert[]

  @@index([lastViewedAt])
}

/// A token the curator promoted to the Curated Alerts feed - the public, self-grading output of
/// the self-learning pipeline. One row per emission (at most one per token per cooldown window).
/// The feed's track record IS the product's marketing, so outcome numbers are copied in from the
/// linked CandidateOutcome as its windows close - the copies survive the training set's own
/// retention horizon, and until they land the API reads the live link instead.
model CuratedAlert {
  id      String @id @default(cuid())
  tokenId String
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  /// The training row whose anchor this alert shares. SetNull, not Cascade: pruning the training
  /// set after CANDIDATE_OUTCOME_RETENTION_DAYS must not erase the public track record.
  candidateOutcomeId String?
  candidateOutcome   CandidateOutcome? @relation(fields: [candidateOutcomeId], references: [id], onDelete: SetNull)

  /// The scan snapshot this alert was emitted from - the same "alerted at" row a Match carries,
  /// so a curated alert can render with the full statistics a Live Feed card shows (volume,
  /// age, graduation, holder concentration) instead of just a market cap. SetNull rather than
  /// Cascade, and deliberately NOT protected from the snapshot retention sweep: the feed's own
  /// record has to outlive the 30-day snapshot horizon, and a card older than that degrades to
  /// the anchor figures copied onto this row rather than disappearing.
  snapshotId String?
  snapshot   TokenSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  /// Which decision-maker emitted it - "heuristic-v1", or a CuratorModel id once the learner
  /// takes over (Phase C). Shown in the feed's learning panel, and what lets the panel compare
  /// the two on their own emissions.
  source     String
  /// The curator's conviction at emission, 0-100.
  confidence Float
  /// Why, as short human-readable strings - the top contributing signals at emission time.
  reasons String[] @default([])

  anchorPriceUsd Float
  anchorMcapUsd  Float

  /// Outcome copies - written by the watcher when the linked row's 1h window (and, for winners,
  /// its 24h watch) closes. Null until then; the API prefers the live candidateOutcome link
  /// while it exists.
  peak1hReturnPct    Float?
  maxDrawdown1hPct   Float?
  hit2xIn1h          Boolean?
  disqualified       Boolean?
  peak24hReturnPct   Float?
  outcomeFinalizedAt DateTime?

  @@index([createdAt])
  @@index([tokenId, createdAt])
}

/// One trained curator - the output of a nightly training run (apps/worker/src/jobs/
/// curatorTrainingJob.ts) over the CandidateOutcome training set. Kept as data, not code: the
/// weights, the feature scaling, the emission threshold, and the walk-forward evidence all live
/// in this row, so promotion is auditable and rollback is "flip status back". At most one row is
/// ACTIVE at a time; while none is, the hand-tuned heuristic curates (curation/curator.ts).
model CuratorModel {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// Model family + featurization version, e.g. "weighted-logistic-v1". A reader that doesn't
  /// recognize the kind must ignore the row rather than guess at params.
  kind String
  /// Everything needed to score a candidate: feature names, standardization stats, weights,
  /// bias, emission threshold. Shape is owned by packages/core/src/curation/trainer.ts.
  params Json
  trainingRows Int
  trainingFrom DateTime
  trainingTo   DateTime
  /// The walk-forward folds this model was judged on, plus the promotion verdict - the public
  /// evidence behind "the model took over" (or didn't).
  evalMetrics Json
  /// candidate: trained + evaluated, not curating. active: the current curator. retired: was
  /// active once.
  status      String
  activatedAt DateTime?
  retiredAt   DateTime?

  @@index([status, createdAt])
}

/// One training sample for the curated-alerts learner: a rug-screen-passing candidate at a
/// moment in time ("the anchor"), plus what its price actually did over the following hour.
/// Written for EVERY scored candidate - not just ones a user filter matched - because a model
/// trained only on user-selected tokens can never learn anything outside the box users already
/// drew. At most one row per token per CANDIDATE_SAMPLE_SPACING_MINUTES, so a token that sits in
/// the mcap band all day yields decorrelated samples rather than sixty near-identical ones an
/// hour. See packages/core/src/curation/ for the label math and feature contract.
model CandidateOutcome {
  id      String @id @default(cuid())
  tokenId String
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  /// The moment the label is measured FROM - "if the curator had alerted right now".
  anchorAt       DateTime @default(now())
  anchorPriceUsd Float
  anchorMcapUsd  Float

  /// The feature vector at the anchor, as {name: number|null} - a denormalized copy of what the
  /// snapshot knew, NOT a snapshot reference, so training data outlives the 30-day
  /// TokenSnapshot purge without forcing snapshots to live 6 months. Names are the stable
  /// contract in packages/core/src/curation/features.ts; null means "genuinely unknown at
  /// anchor time" (the trainer turns those into missing-value indicators, never fake zeros).
  features Json
  /// The heuristic composite score at anchor. Also inside `features`; duplicated as a real
  /// column so stats queries can aggregate on it without unpacking JSON.
  score Float?

  // ---- Watch state (driven by apps/worker/src/jobs/candidateOutcomeJob.ts) ----
  /// When the watcher should next price-check this row. Advances every tick whether or not
  /// DexScreener returned a price, so a dead pair can't hot-loop the sweep.
  nextCheckAt   DateTime
  lastCheckedAt DateTime?
  lastPriceUsd  Float?
  /// Whether this row keeps being watched past the 1h label window, out to 24h - set for rows
  /// that hit 2x (to record how far winners ultimately ran) and for rows a curated alert points
  /// at (their public outcome badge shows the 24h peak). Everything else stops at 1h: the
  /// extended watch is 3x the API volume of the label window, and a dud's 24h peak teaches
  /// nothing the 1h window didn't.
  extended24h Boolean @default(false)

  // ---- Running aggregates, initialized to the anchor price at creation ----
  /// Highest price seen within the 1h label window.
  peak1hPriceUsd Float
  peak1hAt       DateTime?
  /// Lowest price seen within the 1h window - the worst drawdown a buyer at the anchor endured.
  low1hPriceUsd Float
  /// Lowest price seen BEFORE the first observed 2x - frozen the tick the price first reaches
  /// 2x the anchor. This is what decides disqualification: a token that dropped 50%+ and then
  /// "2x'd from the bottom" stopped out anyone who actually bought the alert.
  lowBefore2xPriceUsd Float
  /// First tick at which price >= 2x anchor was observed (within the 1h window).
  hit2xAt DateTime?
  /// Highest price seen over the whole watch (up to 24h for extended rows).
  peak24hPriceUsd Float
  peak24hAt       DateTime?

  // ---- Labels, written once when the 1h window closes ----
  finalizedAt      DateTime?
  /// (peak1h - anchor) / anchor * 100.
  peak1hReturnPct  Float?
  /// (low1h - anchor) / anchor * 100 - zero or negative.
  maxDrawdown1hPct Float?
  hit2xIn1h        Boolean?
  /// Hit 2x, but only after first dropping through the disqualifying drawdown - see
  /// lowBefore2xPriceUsd. Disqualified rows train as losses.
  disqualified     Boolean?
  /// The training target: 0 for a miss or disqualified row, else log2 of the 1h peak multiple,
  /// capped - a 2x is 1.0, a 4x is 2.0, so the learner prefers higher multiples exactly as much
  /// as they're worth in doublings. See computeOneHourLabels in curation/labels.ts.
  labelValue       Float?
  /// Set when the row is completely done (at 1h for non-extended rows, 24h for extended ones).
  finalized24hAt   DateTime?
  peak24hReturnPct Float?

  curatedAlerts CuratedAlert[]

  @@index([tokenId, anchorAt])
  @@index([finalized24hAt, nextCheckAt])
  @@index([anchorAt])
  @@index([finalizedAt])
}

/// A point-in-time reading of a token's market + on-chain state, produced each scan cycle.
model TokenSnapshot {
  id      String @id @default(cuid())
  tokenId String
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  takenAt DateTime @default(now())

  priceUsd          Float
  marketCapUsd      Float
  liquidityUsd      Float?
  volume24hUsd      Float?
  volumeToMcapRatio Float?
  buys24h           Int?
  sells24h          Int?

  holderCount         Int?
  holderGrowthPct     Float?
  top10HolderPct      Float?
  devWalletPct        Float?
  // RugCheck's own composite risk score/named flags - stored raw (not just baked into
  // rugScreenPassed) now that a user can filter on them directly. See rugScreen.ts's
  // CRITICAL_RISK_FLAGS for which named flags matter to excludeCriticalRiskFlags.
  riskScore           Float?
  riskFlags           String[] @default([])
  // % of the (pool-excluded) top-10 holders whose wallet was funded <24h ago - a sniper/insider
  // signal. Null whenever there was no holder list to check (e.g. RugCheck hadn't indexed the
  // mint), the lookup failed, or the whole freshness pass was skipped because no active filter
  // uses maxFreshTop10WalletPct - see apps/worker/src/jobs/walletFreshness.ts. Deliberately null
  // rather than 0 in every one of those cases: 0 would claim we checked and found none fresh.
  freshTop10WalletPct Float?
  // Whether the mint was launched in Pump.fun's Mayhem Mode - an automatic, non-optional
  // rejection (see rugScreen.ts). Recorded here so the Admin Live Feed can show *why* a token
  // was screened out. Null means the check never ran or failed, which the screen also rejects.
  isMayhemMode        Boolean?
  // Whether the mint has graduated off a Pump.fun bonding curve to a real AMM, derived from
  // DexScreener's dexId (see dexscreener.ts's deriveGraduated) - null for anything DexScreener
  // hasn't indexed a pair for at all.
  graduated           Boolean?

  mintAuthorityActive   Boolean?
  freezeAuthorityActive Boolean?
  lpBurned              Boolean?

  /// Float, to sub-minute precision. Was Int, which meant a token 15 seconds old and one 40
  /// seconds old both recorded as "0" and "1" respectively - fine for display, useless for a
  /// filter that wants to distinguish them.
  ageMinutes Float?

  score             Float?
  // Individual components behind `score` (see packages/core/src/scoring/scorer.ts's
  // ScoreBreakdown) - persisted so the dashboard can show *why* a token scored the way it did,
  // not just the composite number. Nullable because snapshots taken before this field existed
  // won't have them.
  scoreMomentum     Float?
  scoreHolderHealth Float?
  scoreAge          Float?
  scoreNarrative    Float?

  rugScreenPassed  Boolean  @default(false)
  rugScreenReasons String[] @default([])

  matches       Match[]
  curatedAlerts CuratedAlert[]

  @@index([tokenId, takenAt])
  @@index([marketCapUsd])
}

/// A token that matched a specific user's filter on a specific scan cycle.
model Match {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  filterId String
  filter   UserFilter @relation(fields: [filterId], references: [id], onDelete: Cascade)

  tokenId String
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  snapshotId String
  snapshot   TokenSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  matchedAt DateTime @default(now())
  score     Float

  deliveredDashboard Boolean   @default(true)
  deliveredTelegram  Boolean   @default(false)
  digestSentAt       DateTime?

  // Backtesting data: the highest market cap observed for this token since the match, tracked by
  // the outcome-tracking job (apps/worker/src/jobs/outcomeTrackingJob.ts). Both null until that
  // job's first run after the match. Baseline for "how far did it run" is snapshot.marketCapUsd
  // (the mcap at match time), not these fields - see outcomeTrackingJob.ts for why.
  peakMcapUsd     Float?
  peakMcapAt      DateTime?
  // (peakMcapUsd - snapshot.marketCapUsd) / snapshot.marketCapUsd * 100 - kept in step with
  // peakMcapUsd by the outcome-tracking job, which recomputes it whenever the peak rises AND
  // repairs it wherever the two have drifted apart (rows whose peak was recorded before this
  // column existed). Persisted rather than computed at read time so the Leaderboard can rank on
  // this column directly instead of pulling every Match ever created into memory to sort.
  peakReturnPct   Float?
  // Set once, as soon as the *recorded peak* is worth >= +100% (a 2x on the alert mcap) - never
  // touched again after that even as peakMcapUsd/peakReturnPct keep climbing on future highs.
  // Deliberately keyed off the recorded peak rather than off "this run saw a new high": a token
  // that 5x'd and then dumped has to stay eligible, and it is by definition never going to set
  // another high. Dated to peakMcapAt (when the qualifying peak was actually seen), not to the
  // run that noticed. Marks this match as eligible for the public Leaderboard; indexed so that
  // query never scans every Match - see apps/api/src/routes/leaderboard.ts.
  hitHundredPctAt DateTime?

  @@unique([userId, tokenId, filterId, matchedAt])
  @@index([userId, matchedAt])
  @@index([tokenId])
  @@index([hitHundredPctAt, peakReturnPct])
}

/// Caches a wallet's earliest-ever transaction timestamp, keyed by address - not scoped to any
/// one Token, since the same wallet can legitimately show up as a top holder on many different
/// mints. This is Helius's single most expensive per-address call (getSignaturesForAddress with
/// limit 1000) and the answer never changes once known, so re-fetching it for a wallet we've
/// already seen - whether on a later scan cycle or as a top holder of a different token in the
/// same cycle - is pure waste. See apps/worker/src/jobs/walletFreshness.ts for how this is
/// populated and read.
model WalletActivityCache {
  address String @id

  /// Null means "we asked and the answer is genuinely indeterminate" - no signatures at all, or a
  /// full getSignaturesForAddress page meaning older history exists beyond it. That's a real,
  /// final answer worth remembering, since re-asking the same unanswerable question every cycle
  /// would be exactly the waste this table exists to avoid.
  ///
  /// Crucially, a row is only ever written for a DEFINITIVE result. A lookup that failed in
  /// transit (timeout, rate limit, RPC error) writes nothing at all, so a transient Helius blip
  /// can't permanently poison a wallet as "indeterminate" - see EarliestActivityResult's
  /// "failed" case in helius.ts and resolveEarliestActivity in walletFreshness.ts.
  earliestActivityAt DateTime?
  checkedAt          DateTime  @default(now())

  /// Supports the cleanup job's retention sweep - without it that DELETE full-scans a table
  /// that grows one row per distinct wallet ever seen.
  @@index([checkedAt])
}

/// Caches mints whose mint AND freeze authorities are both already revoked - the one state that
/// is permanently, irreversibly safe, so a row here is never re-checked or invalidated.
///
/// Deliberately one-directional: revocation can't be undone, but the reverse absolutely happens -
/// a creator who still holds an active authority today can renounce it tomorrow (one of the most
/// common ways a memecoin signals legitimacy). Caching THAT state would permanently fail a token
/// that later became safe, so an unrevoked mint simply gets no row and is re-checked next cycle.
/// Both columns are stored (rather than implied) so the row is self-describing on inspection.
///
/// Only populated on the fallback path where RugCheck has no report for a mint - see
/// resolveMintAuthorities in apps/worker/src/jobs/mintAuthority.ts.
model MintAuthorityCache {
  mintAddress String @id

  mintAuthorityActive   Boolean
  freezeAuthorityActive Boolean
  checkedAt             DateTime @default(now())

  /// Same reason as WalletActivityCache.checkedAt - see the cleanup job's retention sweep.
  @@index([checkedAt])
}

/// Caches whether a mint was launched in Pump.fun's Mayhem Mode, detected by the existence of its
/// `["mayhem-state", mint]` PDA (see mayhemStateAddress() in packages/core/src/solana.ts).
///
/// Unlike MintAuthorityCache, BOTH answers are cached permanently: Mayhem Mode is chosen at launch
/// and cannot be added to or removed from an existing token, so neither a true nor a false can go
/// stale. Only definitive results are written - a lookup that errored stores nothing and is
/// retried, since the rug screen rejects unverified mints and a cached wrong answer would be
/// indistinguishable from a real one.
/// Short-lived cache of RugCheck's per-mint report.
///
/// Unlike MayhemModeCache/MintAuthorityCache, what RugCheck reports is genuinely mutable - holder
/// distribution, dev wallet %, and the composite risk score move constantly - so this is a TTL
/// cache (RUGCHECK_CACHE_TTL_MINUTES), never a permanent one.
///
/// It exists so the scan cadence and the RugCheck request rate can be set independently. RugCheck
/// is called once per in-band candidate per cycle and is the only upstream with no cache at all,
/// which made it, not our own compute, the thing pinning SCAN_INTERVAL_MINUTES. With this, a
/// one-minute scan re-requests a mint at most every TTL minutes, so most cycles only pay for
/// candidates that are newly in band.
///
/// `profile` null means RugCheck genuinely has no report for this mint yet (a 404 - very new
/// token), which is worth caching so those mints aren't re-requested every cycle either. A
/// transport failure is never written here at all - see resolveRugProfiles.
model RugCheckCache {
  mintAddress String   @id
  profile     Json?
  checkedAt   DateTime @default(now())

  @@index([checkedAt])
}

model MayhemModeCache {
  mintAddress String @id

  isMayhemMode Boolean
  checkedAt    DateTime @default(now())

  /// Supports the cleanup job's retention sweep, same as the other RPC caches. The horizon is
  /// about bounding storage rather than staleness - see RPC_CACHE_RETENTION_DAYS.
  @@index([checkedAt])
}

/// How a user came to have access to the Trenches dashboard.
enum AccessSource {
  /// Paid for by burning $ASDFASDFA - see BurnEvent.
  BURN
  /// Granted by hand from the Admin Panel, e.g. to make good on a burn that couldn't be
  /// attributed automatically.
  ///
  /// There is deliberately no WHITELIST member: a whitelisted wallet never gets a Subscription
  /// row at all - resolveAccess() answers for it directly - so a value that could never be
  /// written would just be a state readers have to rule out by hand.
  ADMIN_GRANT
}

/// A user's paid access window.
///
/// One row per user, extended rather than replaced: a renewal moves `expiresAt` forward from
/// whichever is later, now or the current expiry, so buying a second month early stacks instead of
/// throwing away what's left of the first.
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  /// What most recently extended this window. Not an audit trail - BurnEvent is.
  source    AccessSource

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

/// One on-chain burn of the subscription token, whether or not we have a user for it yet.
///
/// This is the ledger, and the chain is its source of truth: every burn the reconciler finds gets
/// a row, including burns from wallets that have never signed in (userId null). A burn is credited
/// exactly once - `signature` is unique, which is what makes both the claim endpoint and the
/// reconciler safe to retry and safe to run at the same time.
model BurnEvent {
  id String @id @default(cuid())

  /// The transaction signature. UNIQUE: this is the replay guard. Two concurrent claims for the
  /// same burn race to insert, one wins, and the loser is handled as "already credited" rather
  /// than as an error.
  signature String @unique

  /// Slot and block time as reported on-chain. blockTime is nullable because Solana does not
  /// guarantee it for older transactions.
  slot      BigInt
  blockTime DateTime?

  /// The `authority` on the burn instruction - the wallet that signed the burn away. This, not
  /// "some signer on the transaction", is who the month belongs to.
  burnerWallet String
  mint         String

  /// Base units (this mint has 6 decimals, so 55200 tokens = "55200000000"). Stored as a string
  /// and compared as BigInt: a float would silently lose precision on large burns, and there is no
  /// good reason to let a rounding error decide whether someone paid.
  rawAmount String

  monthsCredited Int

  /// Null until a User exists for burnerWallet - someone can burn before they ever sign in, and
  /// their months are waiting when they do.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// When this burn was turned into subscription time. Null means found but not yet credited,
  /// which for an unattributed burn is the normal resting state.
  creditedAt DateTime?

  /// Which path found it - "claim" (the user told us) or "reconciler" (we found it ourselves).
  discoveredBy String @default("reconciler")

  createdAt DateTime @default(now())

  @@index([burnerWallet])
  @@index([userId])
  @@index([creditedAt])
}

/// Wallets that get in free, managed from the Admin Panel.
///
/// Keyed by wallet rather than by user id so a wallet can be whitelisted before it has ever signed
/// in - which is the usual case, since you whitelist someone by pasting their address.
model Whitelist {
  walletAddress String @id

  /// Null means indefinite. A date lets you hand out a trial without having to remember to revoke.
  expiresAt DateTime?
  note      String?
  /// Wallet address of the admin who added it, for the audit trail.
  addedBy   String

  createdAt DateTime @default(now())
}

/// Where the burn reconciler got to, so each pass only walks what it hasn't seen.
///
/// A single row (id "burn-scan"). Kept in its own table rather than in SystemHeartbeat.meta
/// because losing it silently would mean silently missing burns - it deserves a column, not a
/// corner of a JSON blob.
model BurnScanCursor {
  id String @id @default("burn-scan")

  /// The newest signature fully processed. The next pass walks backwards from the tip until it
  /// reaches this, then stops. Null on a fresh install, which triggers a bounded first scan.
  lastSignature String?
  /// How far back a cold start is allowed to look, so a fresh deploy doesn't walk all history.
  scanFloor     DateTime?

  updatedAt DateTime @updatedAt
}
